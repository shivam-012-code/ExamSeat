        function setActivePalette(color) {
            currentBrushColor = color;
            document.querySelectorAll('.palette-btn').forEach(b => b.classList.remove('palette-active'));
            document.getElementById('palette_' + color).classList.add('palette-active');
        }

        function openRoomLayoutModal(roomId, roomNo, numCols, columnRowsJson, activeSeatsJson, seatColorsJson) {
            document.getElementById('modalRoomNo').innerText = roomNo;
            document.getElementById('roomSeatsForm').action = '/update_room_seats/' + roomId;

            const columnRows = JSON.parse(columnRowsJson);
            const activeSeats = JSON.parse(activeSeatsJson || '[]');
            const seatColors = JSON.parse(seatColorsJson || '[]');
            
            roomSeatState = {};

            if (seatColors && seatColors.length > 0) {
                seatColors.forEach(sc => {
                    roomSeatState[sc.seat_key] = sc.color;
                });
            } else {
                for (let c = 1; c <= numCols; c++) {
                    const rowsInCol = columnRows[c - 1] || 1;
                    for (let r = 1; r <= rowsInCol; r++) {
                        for (let s = 1; s <= 2; s++) {
                            const sk = `C${c}-R${r}-S${s}`;
                            if (activeSeats.length === 0 || activeSeats.includes(sk)) {
                                roomSeatState[sk] = (s === 1 ? 'color1' : 'color2');
                            } else {
                                roomSeatState[sk] = 'disabled';
                            }
                        }
                    }
                }
            }

            const container = document.getElementById('seatsGridContainer');
            container.innerHTML = '';

            for (let c = 1; c <= numCols; c++) {
                const rowsInCol = columnRows[c - 1] || 1;
                
                let colHtml = `<div class="column-box">`;
                colHtml += `
                    <div class="column-header" style="display: flex; flex-direction: column; align-items: center; gap: 4px; width: 100%;">
                        <span>Col ${c}</span>
                        <div style="display: flex; gap: 3px; width: 100%;">
                            <button type="button" class="btn-blue" style="padding: 2px 4px; font-size: 9px; flex: 1; text-align: center;" onclick="paintColumnSideSeats(${c}, 1)" title="Paint Left Side (S1) seats of Column ${c}">👈 S1</button>
                            <button type="button" class="btn-blue" style="padding: 2px 4px; font-size: 9px; flex: 1; text-align: center;" onclick="paintColumnSideSeats(${c}, 2)" title="Paint Right Side (S2) seats of Column ${c}">👉 S2</button>
                        </div>
                        <button type="button" class="btn-yellow" style="padding: 2px 4px; font-size: 9px; width: 100%; text-align: center; margin-top: 2px;" onclick="paintColumnSeats(${c})" title="Paint ALL seats in Column ${c}">⚡ Both Sides</button>
                    </div>
                `;

                for (let r = 1; r <= rowsInCol; r++) {
                    colHtml += `<div class="bench-row">`;
                    colHtml += `<button type="button" class="btn-yellow" style="padding: 2px 5px; font-size: 9px; line-height: 1.2; border-radius: 4px;" title="Paint Bench ${r}" onclick="paintBenchSeats(${c}, ${r})">R${r}</button>`;
                    
                    for (let s = 1; s <= 2; s++) {
                        const seatKey = `C${c}-R${r}-S${s}`;
                        const currentState = roomSeatState[seatKey] || (s === 1 ? 'color1' : 'color2');
                        
                        let cssClass = 'seat-color1';
                        let isChecked = 'checked';
                        if (currentState === 'color2') {
                            cssClass = 'seat-color2';
                        } else if (currentState === 'disabled') {
                            cssClass = 'seat-disabled';
                            isChecked = '';
                        }

                        colHtml += `
                            <div class="seat-box ${cssClass}" id="box_${seatKey}" onclick="applyBrushToSeat('${seatKey}')" title="Column ${c}, Bench ${r}, Seat ${s}">
                                <input type="checkbox" name="active_seats" value="${seatKey}" id="chk_${seatKey}" ${isChecked} style="display:none;">
                                S${s}
                            </div>
                        `;
                    }
                    colHtml += `</div>`;
                }

                colHtml += `</div>`;
                container.innerHTML += colHtml;
            }

            updateSelectedCount();
            document.getElementById('roomLayoutModal').classList.remove('hidden');
        }

        function applyBrushToSeat(seatKey) {
            roomSeatState[seatKey] = currentBrushColor;
            renderSeatBoxUI(seatKey, currentBrushColor);
            updateSelectedCount();
        }

        function renderSeatBoxUI(seatKey, colorState) {
            const box = document.getElementById('box_' + seatKey);
            const chk = document.getElementById('chk_' + seatKey);

            box.classList.remove('seat-color1', 'seat-color2', 'seat-disabled');

            if (colorState === 'color1') {
                box.classList.add('seat-color1');
                chk.checked = true;
            } else if (colorState === 'color2') {
                box.classList.add('seat-color2');
                chk.checked = true;
            } else {
                box.classList.add('seat-disabled');
                chk.checked = false;
            }
        }

        function paintColumnSideSeats(colNum, side) {
            for (let seatKey in roomSeatState) {
                if (seatKey.startsWith(`C${colNum}-`) && seatKey.endsWith(`-S${side}`)) {
                    roomSeatState[seatKey] = currentBrushColor;
                    renderSeatBoxUI(seatKey, currentBrushColor);
                }
            }
            updateSelectedCount();
        }

        function paintColumnSeats(colNum) {
            for (let seatKey in roomSeatState) {
                if (seatKey.startsWith(`C${colNum}-`)) {
                    roomSeatState[seatKey] = currentBrushColor;
                    renderSeatBoxUI(seatKey, currentBrushColor);
                }
            }
            updateSelectedCount();
        }

        function paintBenchSeats(colNum, rowNum) {
            const prefix = `C${colNum}-R${rowNum}-`;
            for (let seatKey in roomSeatState) {
                if (seatKey.startsWith(prefix)) {
                    roomSeatState[seatKey] = currentBrushColor;
                    renderSeatBoxUI(seatKey, currentBrushColor);
                }
            }
            updateSelectedCount();
        }

        function paintAllSeats(targetColor) {
            for (let seatKey in roomSeatState) {
                roomSeatState[seatKey] = targetColor;
                renderSeatBoxUI(seatKey, targetColor);
            }
            updateSelectedCount();
        }

        function prepareSeatColorsSubmission() {
            const seatColorsArray = [];
            for (let seatKey in roomSeatState) {
                if (roomSeatState[seatKey] !== 'disabled') {
                    seatColorsArray.push({
                        seat_key: seatKey,
                        color: roomSeatState[seatKey]
                    });
                }
            }
            document.getElementById('seatColorsJsonInput').value = JSON.stringify(seatColorsArray);
        }

        function updateSelectedCount() {
            let c1Count = 0;
            let c2Count = 0;
            for (let k in roomSeatState) {
                if (roomSeatState[k] === 'color1') c1Count++;
                if (roomSeatState[k] === 'color2') c2Count++;
            }
            document.getElementById('selectedCountBadge').innerText = `🔵 Color 1: ${c1Count} Seats | 🔴 Color 2: ${c2Count} Seats`;
        }

        function closeRoomLayoutModal() {
            document.getElementById('roomLayoutModal').classList.add('hidden');
        }

        function generateColumnRowInputs() {
            const numCols = parseInt(document.getElementById('numColumnsInput').value, 10);
            const container = document.getElementById('columnRowsContainer');
            const summaryDiv = document.getElementById('roomSummary');

            container.innerHTML = '';
            summaryDiv.style.display = 'none';

            if (!numCols || numCols <= 0) return;

            let html = '<h4 style="margin-bottom: 4px; font-size: 13px; color: #1e3a8a;">Enter number of rows (benches) for each column:</h4>';
            html += '<div style="display: flex; flex-wrap: wrap; gap: 8px;">';

            for (let i = 1; i <= numCols; i++) {
                html += `
                    <div style="background: #f1f5f9; padding: 6px 10px; border-radius: 6px; border: 1px solid #cbd5e1; flex: 1; min-width: 130px; max-width: 180px;">
                        <label style="font-weight: bold; font-size: 12px; display: block; color: #334155;">Column ${i} Rows:</label>
                        <input type="number" name="column_rows" min="1" placeholder="e.g. 10" required 
                               style="width: 100%; margin-top: 4px; padding: 5px 8px; font-size: 13px;" oninput="updateRoomCapacitySummary()">
                    </div>
                `;
            }
            html += '</div>';
            container.innerHTML = html;
        }

        function updateRoomCapacitySummary() {
            const rowInputs = document.querySelectorAll('input[name="column_rows"]');
            const summaryDiv = document.getElementById('roomSummary');
            
            let totalBenches = 0;
            rowInputs.forEach(input => {
                totalBenches += parseInt(input.value, 10) || 0;
            });

            const totalCapacity = totalBenches * 2;
            summaryDiv.innerHTML = `💡 Total Benches: ${totalBenches} | Total Room Capacity: ${totalCapacity} Students (2 per bench)`;
            summaryDiv.style.display = 'block';
        }

        document.addEventListener("DOMContentLoaded", function () {
            const urlParams = new URLSearchParams(window.location.search);
            const activeTab = urlParams.get('active_tab');
            if (activeTab) {
                showSection(activeTab);
            } else if (urlParams.has('branch') || urlParams.has('semester')) {
                showSection('students');
            }
        });
    </script>

</body>

</html>