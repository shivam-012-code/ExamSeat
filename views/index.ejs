                <div>
                    <label style="font-weight: bold; font-size: 12px;">Exam Date:</label>
                    <input id="editExamDate" name="exam_date" type="date" required style="width: 100%; margin-top: 2px;">
                </div>

                <div style="display: flex; gap: 10px;">
                    <div style="flex: 1;">
                        <label style="font-weight: bold; font-size: 12px;">Start Time:</label>
                        <input id="editStartTime" name="start_time" type="time" required style="width: 100%; margin-top: 2px;">
                    </div>
                    <div style="flex: 1;">
                        <label style="font-weight: bold; font-size: 12px;">End Time:</label>
                        <input id="editEndTime" name="end_time" type="time" required style="width: 100%; margin-top: 2px;">
                    </div>
                </div>

                <div class="modal-buttons" style="display: flex; gap: 10px; margin-top: 8px;">
                    <button type="submit" class="btn-green" style="flex: 1;">Save Changes</button>
                    <button type="button" class="btn-red" style="flex: 1;" onclick="closeEditExamModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentBrushColor = 'color1';
        let roomSeatState = {};
        let activeAdminChatBranch = '';
        let activeAdminChatSemester = '';
        let chatPollInterval = null;

        // --- EXAM SEAT LAYOUT PREVIEW & HOVER/CLICK FULL REG NO FUNCTIONS ---

        async function openExamSeatLayoutModal(examId) {
            const modal = document.getElementById('examSeatLayoutModal');
            const loading = document.getElementById('examLayoutLoading');
            const container = document.getElementById('examSeatsGridContainer');
            const hoverBanner = document.getElementById('examSeatHoverBanner');
            const downloadBtn = document.getElementById('downloadExamSeatLayoutBtn');

            modal.classList.remove('hidden');
            loading.classList.remove('hidden');
            container.innerHTML = '';
            downloadBtn.href = '/download_seat_layout_pdf/' + examId;
            hoverBanner.innerHTML = `
                <span>💡 <strong>Hover or Click on any occupied seat</strong> to view the student's Full Registration Number and Name.</span>
                <span id="examSeatStatsBadge" class="badge"></span>
            `;

            try {
                const res = await fetch('/api/exam_seat_layout/' + examId);
                const data = await res.json();
                loading.classList.add('hidden');

                if (!data.success) {
                    container.innerHTML = `<p class="no-data-msg">${data.message || 'Could not load seat layout.'}</p>`;
                    return;
                }

                const { exam, room, assigned_seats } = data;
                document.getElementById('examLayoutRoomTitle').innerText = room.room_no;
                document.getElementById('examLayoutSubTitle').innerText = `${exam.subject} (${exam.branch || 'All'} - Sem ${exam.semester || 'N/A'}) | Date: ${exam.exam_date} | Time: ${exam.start_time} - ${exam.end_time}`;

                const hasActiveConfig = room.active_seats && room.active_seats.length > 0;
                const colorMap = {};
                if (room.seat_colors && room.seat_colors.length > 0) {
                    room.seat_colors.forEach(sc => { colorMap[sc.seat_key] = sc.color; });
                }

                let occupiedCount = 0;

                for (let c = 1; c <= room.columns; c++) {
                    const rowsInCol = (room.column_rows && room.column_rows[c - 1]) ? room.column_rows[c - 1] : (room.rows || 1);
                    let colHtml = `<div class="column-box">`;
                    colHtml += `<div class="column-header" style="padding: 4px 0;">Column ${c}</div>`;

                    for (let r = 1; r <= rowsInCol; r++) {
                        colHtml += `<div class="bench-row">`;
                        colHtml += `<span class="badge" style="background: #f59e0b; color: white; font-size: 10px; padding: 4px 6px;">R${r}</span>`;

                        for (let s = 1; s <= 2; s++) {
                            const seatKey = `C${c}-R${r}-S${s}`;
                            const isDisabled = hasActiveConfig && !room.active_seats.includes(seatKey);
                            const seatColor = colorMap[seatKey] || (s === 1 ? 'color1' : 'color2');
                            const student = assigned_seats[seatKey];

                            let cssClass = 'seat-color1';
                            if (isDisabled) {
                                cssClass = 'seat-disabled';
                            } else if (seatColor === 'color2') {
                                cssClass = 'seat-color2';
                            }

                            if (student) {
                                occupiedCount++;
                                const tooltipText = `Seat: ${room.room_no}-${seatKey} | Full Reg No: ${student.reg_no} | Name: ${student.name} (${student.branch} Sem ${student.semester})`;
                                colHtml += `
                                    <div class="exam-seat-item ${cssClass}"
                                         id="exam_seat_${seatKey}"
                                         title="${tooltipText}"
                                         data-seat="${room.room_no}-${seatKey}"
                                         data-reg="${student.reg_no}"
                                         data-last3="${student.last3}"
                                         data-name="${student.name}"
                                         data-branch="${student.branch}"
                                         data-sem="${student.semester}"
                                         data-subject="${student.subject}"
                                         onmouseenter="showFullRegOnSeat(this, false)"
                                         onmouseleave="restoreLast3OnSeat(this)"
                                         onclick="showFullRegOnSeat(this, true)">
                                        <span style="font-size: 9px; opacity: 0.85;">S${s}</span>
                                        <span class="seat-reg-label" style="font-size: 12px; letter-spacing: 0.5px;">..${student.last3}</span>
                                    </div>
                                `;
                            } else if (isDisabled) {
                                colHtml += `
                                    <div class="exam-seat-item seat-disabled" title="Seat ${seatKey} (Disabled)">
                                        <span style="font-size: 10px;">S${s}</span>
                                    </div>
                                `;
                            } else {
                                colHtml += `
                                    <div class="exam-seat-item ${cssClass}" style="opacity: 0.45;" title="Seat ${room.room_no}-${seatKey} (Empty)">
                                        <span style="font-size: 9px;">S${s}</span>
                                        <span style="font-size: 9px;">Empty</span>
                                    </div>
                                `;
                            }
                        }

                        colHtml += `</div>`;
                    }

                    colHtml += `</div>`;
                    container.innerHTML += colHtml;
                }

                const badgeEl = document.getElementById('examSeatStatsBadge');
                if (badgeEl) badgeEl.innerText = `${occupiedCount} Students Seated`;
            } catch (err) {
                console.error(err);
                loading.classList.add('hidden');
                container.innerHTML = '<p class="no-data-msg" style="color: red;">Error loading seat layout.</p>';
            }
        }

        function showFullRegOnSeat(seatElem, isClick) {
            const fullReg = seatElem.getAttribute('data-reg');
            const name = seatElem.getAttribute('data-name');
            const seatNo = seatElem.getAttribute('data-seat');
            const branch = seatElem.getAttribute('data-branch');
            const sem = seatElem.getAttribute('data-sem');
            const subject = seatElem.getAttribute('data-subject');

            const labelSpan = seatElem.querySelector('.seat-reg-label');
            if (labelSpan) {
                labelSpan.innerText = fullReg;
                labelSpan.style.fontSize = '10px';
            }

            if (isClick) {
                document.querySelectorAll('.exam-seat-item').forEach(el => {
                    if (el !== seatElem) {
                        el.classList.remove('exam-seat-active-focus');
                        el.removeAttribute('data-locked');
                        const sp = el.querySelector('.seat-reg-label');
                        if (sp && el.getAttribute('data-last3')) {
                            sp.innerText = '..' + el.getAttribute('data-last3');
                            sp.style.fontSize = '12px';
                        }
                    }
                });
                const isAlreadyLocked = seatElem.getAttribute('data-locked') === 'true';
                if (isAlreadyLocked) {
                    seatElem.removeAttribute('data-locked');
                    seatElem.classList.remove('exam-seat-active-focus');
                } else {
                    seatElem.setAttribute('data-locked', 'true');
                    seatElem.classList.add('exam-seat-active-focus');
                }
            }

            const hoverBanner = document.getElementById('examSeatHoverBanner');
            if (hoverBanner) {
                hoverBanner.innerHTML = `
                    <div>
                        🎯 <strong>Seat:</strong> <span class="badge">${seatNo}</span> &nbsp;|&nbsp;
                        <strong>Full Reg No:</strong> <span class="badge bg-blue" style="font-size: 13px;">${fullReg}</span> &nbsp;|&nbsp;
                        <strong>Name:</strong> <b>${name}</b> (${branch} - Sem ${sem}) &nbsp;|&nbsp;
                        <strong>Subject:</strong> ${subject}
                    </div>
                `;
            }
        }

        function restoreLast3OnSeat(seatElem) {
            if (seatElem.getAttribute('data-locked') === 'true') return;
            const last3 = seatElem.getAttribute('data-last3');
            const labelSpan = seatElem.querySelector('.seat-reg-label');
            if (labelSpan && last3) {
                labelSpan.innerText = '..' + last3;
                labelSpan.style.fontSize = '12px';
            }
        }

        function closeExamSeatLayoutModal() {
            document.getElementById('examSeatLayoutModal').classList.add('hidden');
        }

        // --- MCQ FUNCTIONS (ADMIN & STUDENT) ---

        function toggleMcqAnswerInputType(mode) {
            const typeSelect = document.getElementById(mode === 'edit' ? 'editMcqType' : 'mcqType');
            const container = document.getElementById(mode === 'edit' ? 'editMcqOptionsList' : 'mcqOptionsList');
            const isMulti = typeSelect.value === 'multiple';
            const selectors = container.querySelectorAll('.mcq-correct-selector');

            selectors.forEach(inp => {
                inp.type = isMulti ? 'checkbox' : 'radio';
                inp.checked = false;
            });
        }

        function addMcqOptionRow(mode, textVal = '', isChecked = false) {
            const typeSelect = document.getElementById(mode === 'edit' ? 'editMcqType' : 'mcqType');
            const container = document.getElementById(mode === 'edit' ? 'editMcqOptionsList' : 'mcqOptionsList');
            const isMulti = typeSelect.value === 'multiple';
            const nextIndex = container.querySelectorAll('.mcq-opt-item').length + 1;
            const radioName = mode === 'edit' ? 'editMcqCorrectSelect' : 'mcqCorrectSelect';

            const div = document.createElement('div');
            div.className = 'mcq-opt-item';
            div.style = 'display: flex; align-items: center; gap: 8px;';
            div.innerHTML = `
                <input type="${isMulti ? 'checkbox' : 'radio'}" name="${radioName}" class="mcq-correct-selector" value="${nextIndex}" ${isChecked ? 'checked' : ''} title="Mark as Correct Answer" style="width: 18px; height: 18px; cursor: pointer; accent-color: #16a34a;">
                <input type="text" class="mcq-option-text" placeholder="Option ${nextIndex}" value="${textVal.replace(/"/g, '&quot;')}" style="flex: 1; padding: 8px;">
            `;
            container.appendChild(div);
        }

        async function submitCreateMcq() {
            const branch = document.getElementById('mcqBranch').value;
            const semester = document.getElementById('mcqSemester').value;
            const subject = document.getElementById('mcqSubject').value.trim() || 'General';
            const isMultiple = document.getElementById('mcqType').value === 'multiple';
            const question = document.getElementById('mcqQuestionText').value.trim();

            if (!branch || !semester) {
                alert('Please select both Branch and Semester first.');
                return;
            }
            if (!question) {
                alert('Please enter the MCQ question.');
                return;
            }

            const items = document.querySelectorAll('#mcqOptionsList .mcq-opt-item');
            const options = [];
            const correct_options = [];

            items.forEach((item) => {
                const txt = item.querySelector('.mcq-option-text').value.trim();
                const chk = item.querySelector('.mcq-correct-selector').checked;
                if (txt.length > 0) {
                    options.push(txt);
                    if (chk) {
                        correct_options.push(options.length);
                    }
                }
            });

            if (options.length < 2) {
                alert('Please enter at least 2 options.');
                return;
            }
            if (correct_options.length === 0) {
                alert('Please mark the correct answer(s) before posting the question.');
                return;
            }

            try {
                const res = await fetch('/api/mcq/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        branch,
                        semester,
                        subject,
                        question,
                        options,
                        correct_options,
                        is_multiple: isMultiple
                    })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/?active_tab=pyqs';
                } else {
                    alert(data.message || 'Error posting MCQ');
                }
            } catch (err) {
                console.error(err);
                alert('Server error creating MCQ');
            }
        }

        function openEditMcqModalFromBtn(btnElem) {
            const mcq = JSON.parse(decodeURIComponent(btnElem.getAttribute('data-mcq')));
            document.getElementById('editMcqId').value = mcq.id;
            document.getElementById('editMcqBranch').value = mcq.branch;
            document.getElementById('editMcqSemester').value = mcq.semester;
            document.getElementById('editMcqSubject').value = mcq.subject || 'General';
            document.getElementById('editMcqType').value = mcq.is_multiple ? 'multiple' : 'single';
            document.getElementById('editMcqQuestionText').value = mcq.question;

            const container = document.getElementById('editMcqOptionsList');
            container.innerHTML = '';

            mcq.options.forEach(opt => {
                const isCorr = mcq.correct_options.includes(opt.option_id);
                addMcqOptionRow('edit', opt.text, isCorr);
            });

            document.getElementById('editMcqModal').classList.remove('hidden');
        }

        function closeEditMcqModal() {
            document.getElementById('editMcqModal').classList.add('hidden');
        }

        async function submitEditMcq() {
            const id = document.getElementById('editMcqId').value;
            const branch = document.getElementById('editMcqBranch').value;
            const semester = document.getElementById('editMcqSemester').value;
            const subject = document.getElementById('editMcqSubject').value.trim() || 'General';
            const isMultiple = document.getElementById('editMcqType').value === 'multiple';
            const question = document.getElementById('editMcqQuestionText').value.trim();

            const items = document.querySelectorAll('#editMcqOptionsList .mcq-opt-item');
            const options = [];
            const correct_options = [];

            items.forEach(item => {
                const txt = item.querySelector('.mcq-option-text').value.trim();
                const chk = item.querySelector('.mcq-correct-selector').checked;
                if (txt.length > 0) {
                    options.push(txt);
                    if (chk) {
                        correct_options.push(options.length);
                    }
                }
            });

            if (!question || options.length < 2) {
                alert('Please provide a valid question and at least 2 options.');
                return;
            }
            if (correct_options.length === 0) {
                alert('Please mark at least one correct option.');
                return;
            }

            try {
                const res = await fetch('/api/mcq/edit/' + id, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        branch,
                        semester,
                        subject,
                        question,
                        options,
                        correct_options,
                        is_multiple: isMultiple
                    })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/?active_tab=pyqs';
                } else {
                    alert(data.message || 'Error updating MCQ');
                }
            } catch (err) {
                console.error(err);
                alert('Server error updating MCQ');
            }
        }

        async function openInspectMcqModal(mcqId) {
            document.getElementById('inspectMcqModal').classList.remove('hidden');
            document.getElementById('inspectMcqLoading').classList.remove('hidden');
            document.getElementById('inspectMcqContent').classList.add('hidden');
            document.getElementById('inspectMcqNoData').classList.add('hidden');
            document.getElementById('inspectMcqTableBody').innerHTML = '';
            document.getElementById('inspectMcqStatsSummary').innerHTML = '';

            try {
                const res = await fetch('/api/mcq/voters/' + mcqId);
                const data = await res.json();
                document.getElementById('inspectMcqLoading').classList.add('hidden');
                document.getElementById('inspectMcqContent').classList.remove('hidden');

                if (data.success) {
                    document.getElementById('inspectMcqQuestionTitle').innerText = `"${data.question}" (Total Votes: ${data.total_votes})`;

                    let statsHtml = '<h4 style="margin: 0 0 8px 0; color: #1e3a8a;">Option-wise Selection Percentage:</h4>';
                    data.option_stats.forEach(st => {
                        statsHtml += `
                            <div style="margin-bottom: 6px;">
                                <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: bold;">
                                    <span style="color: ${st.is_correct ? '#15803d' : '#1e293b'};">${st.is_correct ? '✔ (Correct Answer) ' : ''}${st.text}</span>
                                    <span>${st.count} students (${st.percentage}%)</span>
                                </div>
                                <div class="poll-progress-bg" style="margin: 3px 0 0 0; height: 8px;">
                                    <div class="poll-progress-fill" style="width: ${st.percentage}%; background: ${st.is_correct ? '#16a34a' : '#2563eb'};"></div>
                                </div>
                            </div>
                        `;
                    });
                    document.getElementById('inspectMcqStatsSummary').innerHTML = statsHtml;

                    if (data.voters && data.voters.length > 0) {
                        const tbody = document.getElementById('inspectMcqTableBody');
                        data.voters.forEach(v => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td><strong>${v.reg_no}</strong></td>
                                <td>${v.name}</td>
                                <td>${v.chosen_options.map(o => `<span class="badge" style="margin: 2px;">${o}</span>`).join(' ')}</td>
                                <td>
                                    <span class="badge" style="background: ${v.is_correct ? '#16a34a' : '#dc2626'}; color: white;">
                                        ${v.is_correct ? '✔ Correct' : '✖ Wrong'}
                                    </span>
                                </td>
                                <td>${new Date(v.submitted_at).toLocaleString()}</td>
                            `;
                            tbody.appendChild(tr);
                        });
                    } else {
                        document.getElementById('inspectMcqNoData').classList.remove('hidden');
                    }
                }
            } catch (err) {
                console.error(err);
                document.getElementById('inspectMcqLoading').innerHTML = '<span style="color:red;">Error loading MCQ responses.</span>';
            }
        }

        function closeInspectMcqModal() {
            document.getElementById('inspectMcqModal').classList.add('hidden');
        }

        async function submitStudentMcqAnswer(mcqId) {
            const inputs = document.querySelectorAll(`input[name="student_mcq_${mcqId}"]:checked`);
            const selected = Array.from(inputs).map(i => Number(i.value));

            if (selected.length === 0) {
                alert('Please select an option before clicking Submit.');
                return;
            }

            try {
                const res = await fetch('/api/mcq/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mcq_id: mcqId, selected_options: selected })
                });
                const data = await res.json();
                if (!data.success) {
                    alert(data.message || 'Could not submit answer');
                    return;
                }

                const allInputs = document.querySelectorAll(`input[name="student_mcq_${mcqId}"]`);
                allInputs.forEach(inp => {
                    inp.disabled = true;
                    const optId = Number(inp.value);
                    const lbl = document.getElementById(`mcq_lbl_${mcqId}_${optId}`);
                    const badgeBox = document.getElementById(`mcq_badge_${mcqId}_${optId}`);

                    const isSelected = data.selected_options.includes(optId);
                    const isCorrectOpt = data.correct_options.includes(optId);

                    if (lbl) {
                        lbl.style.cursor = 'default';
                        if (isCorrectOpt) {
                            lbl.style.background = '#dcfce7';
                            lbl.style.border = '2px solid #16a34a';
                        } else if (isSelected && !isCorrectOpt) {
                            lbl.style.background = '#fee2e2';
                            lbl.style.border = '2px solid #dc2626';
                        }
                    }

                    if (badgeBox) {
                        let bHtml = '';
                        if (isSelected) {
                            bHtml += `<span class="badge" style="background: #1e293b; color: white; font-size: 11px; margin-right: 5px;">Your Choice</span>`;
                        }
                        if (isCorrectOpt) {
                            bHtml += `<span class="badge bg-green" style="font-size: 11px;">✔ Correct Answer</span>`;
                        } else if (isSelected && !isCorrectOpt) {
                            bHtml += `<span class="badge bg-red" style="font-size: 11px;">✖ Wrong</span>`;
                        }
                        badgeBox.innerHTML = bHtml;
                    }
                });

                const actionArea = document.getElementById(`mcq_action_area_${mcqId}`);
                if (actionArea) {
                    actionArea.innerHTML = `
                        <div class="alert ${data.is_correct ? 'alert-success' : 'alert-error'}" style="margin: 0; font-weight: bold; font-size: 14px;">
                            ${data.feedback_msg}
                        </div>
                        <div style="margin-top: 6px; font-size: 12px; color: #64748b; font-weight: bold;">
                            <i class="fa-solid fa-lock"></i> Answer submitted & locked. You cannot change your answer.
                        </div>
                    `;
                }
            } catch (err) {
                console.error(err);
                alert('Server error while submitting answer.');
            }
        }

        // --- ADMIN CHAT & POLL FUNCTIONS ---

        function initAdminChatRoom() {
            activeAdminChatBranch = document.getElementById('adminChatBranch').value;
            activeAdminChatSemester = document.getElementById('adminChatSemester').value;

            if (activeAdminChatBranch && activeAdminChatSemester) {
                document.getElementById('adminChatStatus').innerText = `Connected to ${activeAdminChatBranch} - Semester ${activeAdminChatSemester}`;
                document.getElementById('adminChatStatus').style.color = '#16a34a';
                document.getElementById('adminChatWrapper').classList.remove('hidden');

                loadAdminChatData();
                if (chatPollInterval) clearInterval(chatPollInterval);
                chatPollInterval = setInterval(loadAdminChatData, 3000);
            } else {
                document.getElementById('adminChatWrapper').classList.add('hidden');
                document.getElementById('adminChatStatus').innerText = 'Select the Branch and Semester first.';
                document.getElementById('adminChatStatus').style.color = '#64748b';
                if (chatPollInterval) clearInterval(chatPollInterval);
            }
        }

        async function loadAdminChatData() {
            if (!activeAdminChatBranch || !activeAdminChatSemester) return;

            try {
                const res = await fetch(`/api/chat/${activeAdminChatBranch}/${activeAdminChatSemester}`);
                const data = await res.json();
                if (data.success) {
                    renderAdminMessages(data.messages);
                    renderAdminPolls(data.polls);
                }
            } catch (err) {
                console.error(err);
            }
        }

        function renderAdminMessages(messages) {
            const container = document.getElementById('adminChatMessages');
            const atBottom = container.scrollHeight - container.scrollTop <= container.clientHeight + 50;

            container.innerHTML = '';
            if (messages.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: #94a3b8; font-style: italic;">No messages yet. (Auto-deletes in 24 hours)</p>';
                return;
            }

            messages.forEach(m => {
                const div = document.createElement('div');
                div.className = m.sender_role === 'admin' ? 'chat-bubble chat-bubble-admin' : 'chat-bubble chat-bubble-student';
                
                const senderTitle = m.sender_role === 'student'
                    ? `${m.sender_name}`
                    : `${m.sender_name} <span class="badge" style="font-size:9px; background:#1e40af; color:white;">ADMIN</span>`;

                div.innerHTML = `
                    <div style="font-weight: bold; font-size: 11px; margin-bottom: 2px; color: ${m.sender_role === 'admin' ? '#1e40af' : '#0f172a'};">
                        ${senderTitle}
                        <span style="font-weight: normal; font-size: 10px; color: #64748b; margin-left: 6px;">${new Date(m.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                    </div>
                    <div>${m.message}</div>
                `;
                container.appendChild(div);
            });

            if (atBottom) container.scrollTop = container.scrollHeight;
        }

        function renderAdminPolls(polls) {
            const container = document.getElementById('adminPollsList');
            container.innerHTML = '';

            if (polls.length === 0) {
                container.innerHTML = '<p style="color: #64748b; font-style: italic;">No active polls. (Auto-deletes in 48 hours)</p>';
                return;
            }

            polls.forEach(p => {
                const div = document.createElement('div');
                div.className = 'poll-card';

                let optionsHtml = '';
                p.options.forEach(opt => {
                    const pct = p.total_voters > 0 ? Math.round((opt.votes_count / p.total_voters) * 100) : 0;
                    optionsHtml += `
                        <div class="poll-option-row">
                            <span style="font-weight: bold; font-size: 13px; min-width: 100px;">${opt.text}</span>
                            <div class="poll-progress-bg">
                                <div class="poll-progress-fill" style="width: ${pct}%;"></div>
                            </div>
                            <span style="font-size: 12px; font-weight: bold; color: #1e3a8a;">${opt.votes_count} votes (${pct}%)</span>
                        </div>
                    `;
                });

                div.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                        <h4 style="margin: 0; color: #0f172a; font-size: 14px;">${p.question}</h4>
