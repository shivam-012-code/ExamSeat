                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td><strong>${m.reg_no}</strong></td>
                            <td>${m.name}</td>
                            <td><span class="badge">${m.branch || 'N/A'}</span> Sem ${m.semester || 'N/A'}</td>
                            <td>${qHtml}</td>
                            <td>
                                <span class="badge" style="background: #16a34a; color: white; font-size: 12px; padding: 5px 10px;">
                                    ${m.marks_obtained} / ${m.total_marks}
