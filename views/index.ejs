        async function togglePyqProgress(pyqId, checkboxElem) {
            const statusSpan = document.getElementById('status_pyq_' + pyqId);
            const prevChecked = !checkboxElem.checked;

            try {
                const res = await fetch('/toggle_pyq_status/' + pyqId, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    checkboxElem.checked = data.is_completed;
                    if (statusSpan) {
                        if (data.is_completed) {
                            statusSpan.className = 'badge bg-green';
                            statusSpan.innerText = 'Completed';
                        } else {
                            statusSpan.className = 'badge';
                            statusSpan.style.background = '#94a3b8';
                            statusSpan.style.color = '#ffffff';
                            statusSpan.innerText = 'Pending';
                        }
                    }
                } else {
                    checkboxElem.checked = prevChecked;
                }
            } catch (err) {
                console.error(err);
                checkboxElem.checked = prevChecked;
            }
        }

        function filterStudentPyqs() {
            const filterVal = document.getElementById('studentSubjectFilter').value.toLowerCase().trim();
            const rows = document.querySelectorAll('.student-pyq-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const sub = (row.getAttribute('data-subject') || '').toLowerCase().trim();
                if (!filterVal || sub === filterVal) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const noDataMsg = document.getElementById('noSubjectPyqMsg');
            if (noDataMsg) {
                if (visibleCount === 0) {
                    noDataMsg.classList.remove('hidden');
                } else {
                    noDataMsg.classList.add('hidden');
                }
            }

            const mcqCards = document.querySelectorAll('.student-mcq-card');
            mcqCards.forEach(card => {
                const sub = (card.getAttribute('data-subject') || '').toLowerCase().trim();
                if (!filterVal || sub === filterVal) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

