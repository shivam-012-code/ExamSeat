                        document.getElementById('inspectVotersNoData').classList.remove('hidden');
                    }
                }
            } catch (err) {
                console.error(err);
                document.getElementById('inspectVotersLoading').innerHTML = '<span style="color:red;">Error loading voter details.</span>';
