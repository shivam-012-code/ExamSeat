                                        <button type="button" class="btn-yellow" style="margin-bottom: 5px; font-size: 12px; padding: 6px 10px;"
                                            data-mcq="<%= encodeURIComponent(JSON.stringify(m)) %>"
                                            onclick="openEditMcqModalFromBtn(this)">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </button>
                                        <form action="/delete_mcq/<%= m.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Are you sure you want to delete this MCQ question and all its student responses?');">
                                            <button type="submit" class="btn-red" style="font-size: 12px; padding: 6px 10px;"><i class="fa-solid fa-trash"></i> Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </table>
                    <% } %>
                </section>

                <!-- ADMIN CHAT & POLL FEATURE SECTION -->
                <section id="admin_chat" class="hidden">
