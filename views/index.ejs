        async function submitCreatePoll() {
            const question = document.getElementById('newPollQuestion').value.trim();
            const optionInputs = document.querySelectorAll('.poll-option-input');
            const options = Array.from(optionInputs).map(i => i.value.trim()).filter(v => v.length > 0);
            const isMultiple = document.getElementById('pollIsMultiple').checked;

            if (!question) {
                alert('Please enter a poll question.');
                return;
            }
            if (options.length < 2) {
                alert('Please enter at least 2 valid options.');
                return;
            }

            try {
                const res = await fetch('/api/poll/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        branch: activeAdminChatBranch,
                        semester: activeAdminChatSemester,
                        question,
                        options,
                        is_multiple: isMultiple
                    })
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('newPollQuestion').value = '';
                    optionInputs.forEach(i => i.value = '');
                    document.getElementById('pollIsMultiple').checked = false;
                    loadAdminChatData();
                } else {
                    alert(data.message || 'Error creating poll');
                }
            } catch (err) {
                console.error(err);
            }
        }

