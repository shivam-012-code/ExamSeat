<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ExamSeat Portal</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="shortcut icon" href="https://img.icons8.com/pulsar-gradient/48/quiz.png" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=PT+Serif+Caption:ital@0;1&display=swap" rel="stylesheet">
</head>

<body>

    <header>
        <h2><i class="fa-solid fa-graduation-cap"></i> ExamSeat</h2>
        <div class="user-info">
            <span><b><i class="fa-solid fa-user"></i></b> <%= user.username %> (<strong style="text-transform: capitalize;"> <%= user.role %></strong>)</span>
            <a href="/logout" class="logout-btn"><strong>Logout</strong> <i class="fa-solid fa-arrow-right-from-bracket"></i></a>
        </div>
    </header>

    <div class="container">

        <aside>
            <button onclick="showSection('dashboard')"><i class="fa-solid fa-arrow-trend-up"></i> Dashboard</button>
            <% if (user.role==='admin' ) { %>
                <button onclick="showSection('students')"><i class="fa-solid fa-user-graduate"></i> Students & Upload</button>
                <button onclick="showSection('rooms')"><i class="fa-solid fa-school"></i> Rooms</button>
                <button onclick="showSection('exams')"><i class="fa-solid fa-file-pen"></i> Exams & Seating</button>
                <button onclick="showSection('marks')"><i class="fa-solid fa-file-arrow-up"></i> Marks & Papers</button>
                <button onclick="showSection('pyqs')"><i class="fa-solid fa-book-open"></i> Pyqs & Questions</button>
                <button onclick="showSection('admin_chat')"><i class="fa-solid fa-comments"></i> Chat Feature</button>
                <button onclick="showSection('admin_users')"><i class="fa-solid fa-user-shield"></i> Admin</button>
                <% } else { %>
                    <button onclick="showSection('my_seating')"><i class="fa-solid fa-couch"></i> My Exam Seat</button>
                    <button onclick="showSection('my_exams_marks')"><i class="fa-solid fa-square-poll-vertical"></i> My Exams & Marks</button>
                    <button onclick="showSection('student_pyqs')"><i class="fa-solid fa-book-open"></i> Pyqs & Questions</button>
                    <button onclick="showSection('student_chat')"><i class="fa-solid fa-comments"></i> Chat Feature</button>
                    <% } %>
        </aside>

        <main>

            <!-- DASHBOARD -->
            <section id="dashboard">
                <h1 style="font-size: 30px;">Welcome, <%= user.username %></h1>
                <br>
                <p style="font-size: 20px;">Role: <strong><%= user.role.toUpperCase() %></strong></p>
                <br>

                <% if (user.role==='admin' ) { %>
                    <div class="cards">
                        <div class="card">
                            <h3>Students</h3>
                            <p class="pt-serif-caption-regular"><%= students.length %></p>
                        </div>
                        <div class="card">
                            <h3>Rooms</h3>
                            <p class="pt-serif-caption-regular"><%= rooms.length %></p>
                        </div>
                        <div class="card">
                            <h3>Exams</h3>
                            <p class="pt-serif-caption-regular"><%= exams.length %></p>
                        </div>
                    </div>
                    <% } else { %>
                        <br>
                        <div class="student-profile-card">
                            <h2>Personal Details</h2>
                            <% if (studentInfo) { %>
                                <p><strong>Name:</strong> <%= studentInfo.name %></p>
                                <p><strong>Reg No:</strong> <%= studentInfo.reg_no %></p>
                                <p><strong>Branch:</strong> <%= studentInfo.branch || 'N/A' %></p>
                                <p><strong>Semester:</strong> <%= studentInfo.semester ? studentInfo.semester : 'N/A' %></p>
                                <% } else { %>
                                    <p class="text-warning">⚠️ Student profile record not found for this Registration Number <strong><%= user.username %></strong>.</p>
                                    <% } %>
                        </div>
                        <% } %>
            </section>

            <% if (user.role==='admin' ) { %>

                <!-- STUDENTS SECTION -->
                <section id="students" class="hidden">
                    <div class="selection-card">
                        <h2><i class="fa-solid fa-filter"></i> Select Branch & Semester</h2>
                        <p class="select-instruction">Select a Branch first, then choose a Semester from 1st to 6th to view, search, or upload student records.</p>

                        <div class="filter-controls">
                            <div class="control-group">
                                <label><strong>1. Branch:</strong></label>
                                <select id="selectBranch" onchange="handleBranchChange()" class="select-input">
                                    <option value="">-- Choose Branch --</option>
                                    <option value="CSE" <%=selectedBranch==='CSE' ? 'selected' : '' %>>CSE</option>
                                    <option value="ME" <%=selectedBranch==='ME' ? 'selected' : '' %>>ME</option>
                                    <option value="AE" <%=selectedBranch==='AE' ? 'selected' : '' %>>AE</option>
                                    <option value="CE" <%=selectedBranch==='CE' ? 'selected' : '' %>>CE</option>
                                    <option value="EE" <%=selectedBranch==='EE' ? 'selected' : '' %>>EE</option>
                                    <option value="ECE" <%=selectedBranch==='ECE' ? 'selected' : '' %>>ECE</option>
                                </select>
                            </div>

                            <div class="control-group">
                                <label><strong>2. Semester:</strong></label>
                                <select id="selectSemester" onchange="handleSemesterChange()" class="select-input" <%=selectedBranch ? '' : 'disabled' %>>
                                    <option value="">-- Choose Semester --</option>
                                    <option value="1" <%=selectedSemester=='1' ? 'selected' : '' %>>1st</option>
                                    <option value="2" <%=selectedSemester=='2' ? 'selected' : '' %>>2nd</option>
                                    <option value="3" <%=selectedSemester=='3' ? 'selected' : '' %>>3rd</option>
                                    <option value="4" <%=selectedSemester=='4' ? 'selected' : '' %>>4th</option>
                                    <option value="5" <%=selectedSemester=='5' ? 'selected' : '' %>>5th</option>
                                    <option value="6" <%=selectedSemester=='6' ? 'selected' : '' %>>6th</option>
                                </select>
                            </div>

                            <% if (selectedBranch || selectedSemester) { %>
                                <div class="control-group" style="align-self: flex-end;">
                                    <a href="/" class="btn-clear-filter"><i class="fa-solid fa-rotate-left"></i> View All Students</a>
                                </div>
                                <% } %>
                        </div>
                    </div>

                    <% if (selectedBranch && selectedSemester) { %>
                        <div id="studentUploadContainer">
                            <div class="search-box-card">
                                <h3><i class="fa-solid fa-magnifying-glass"></i> Search Students in <%= selectedBranch %> (Semester <%= selectedSemester %>)</h3>
                                <form action="/" method="GET" style="display: flex; gap: 10px; margin-top: 10px;">
                                    <input type="hidden" name="branch" value="<%= selectedBranch %>">
                                    <input type="hidden" name="semester" value="<%= selectedSemester %>">
                                    <input name="student_search" placeholder="Search by Student Name or Registration Number" value="<%= studentSearchQuery %>" style="flex: 1;" class="select-input">
                                    <button type="submit" class="btn-blue"><i class="fa-solid fa-search"></i> Search</button>
                                    <% if (studentSearchQuery) { %>
                                        <a href="/?branch=<%= encodeURIComponent(selectedBranch) %>&semester=<%= encodeURIComponent(selectedSemester) %>" class="btn-clear-filter" style="display: inline-flex; align-items: center;">Clear Search</a>
                                        <% } %>
                                </form>
                            </div>

                            <br>

                            <div class="form-grid">
                                <div class="upload-box">
                                    <h2><i class="fa-solid fa-user-plus"></i> Add Single Student</h2>
                                    <form action="/add_student" method="POST">
                                        <input type="hidden" name="branch" value="<%= selectedBranch %>">
                                        <input type="hidden" name="semester" value="<%= selectedSemester %>">
                                        <input name="reg_no" placeholder="Registration Number" required>
                                        <input name="name" placeholder="Student Name" required>
                                        <button type="submit">Add Student</button>
                                    </form>
                                    <small><strong>Note:</strong> The Registration Number is in the format of <strong>121XXXXXXX</strong></small>
                                </div>

                                <div class="upload-box">
                                    <h2><i class="fa-regular fa-folder-open"></i> Bulk Upload Excel Sheet</h2>
                                    <form action="/upload_students" method="POST" enctype="multipart/form-data">
                                        <input type="hidden" name="branch" value="<%= selectedBranch %>">
                                        <input type="hidden" name="semester" value="<%= selectedSemester %>">
                                        <input type="file" name="excel_file" accept=".xlsx, .xls" required>
                                        <div style="display: flex; gap: 10px; margin-top: 5px;">
                                            <button type="submit" class="btn-green" style="flex: 1;"><i class="fa-solid fa-upload"></i> Upload</button>
                                            <button type="button" class="btn-blue" style="flex: 1;" onclick="openSampleExcelModal()"><i class="fa-solid fa-file-excel"></i> Sample Excel</button>
                                        </div>
                                    </form>
                                    <small><strong>Note:</strong> Click 'Sample Excel' to view the excel format.</small>
                                </div>
                            </div>
                        </div>
                        <% } %>

                            <br>
                            <h2>
                                <% if (selectedBranch && selectedSemester) { %>
                                    Students in <%= selectedBranch %> (Semester <%= selectedSemester %>) <% if(studentSearchQuery) { %>— Matching "<%= studentSearchQuery %>"<% } %> (<%= students.length %> Found)
                                <% } else { %>
                                    All Registered Students (<%= students.length %> Total)
                                <% } %>
                            </h2>

                            <% if (students.length===0) { %>
                                <p class="no-data-msg">No student records found matching your selection or search query.</p>
                                <% } else { %>
                                    <table>
                                        <tr>
                                            <th>Registration No</th>
                                            <th>Name</th>
                                            <th>Branch</th>
                                            <th>Semester</th>
                                            <th>Actions</th>
                                        </tr>
                                        <% students.forEach(student=> { %>
                                            <tr>
                                                <td><%= student.reg_no %></td>
                                                <td><%= student.name %></td>
                                                <td><span class="badge"><%= student.branch || 'N/A' %></span></td>
                                                <td>Semester <%= student.semester || 'N/A' %></td>
                                                <td>
                                                    <form action="/delete_student/<%= student.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Are you sure you want to delete <%= student.name %>?');">
                                                        <input type="hidden" name="branch" value="<%= selectedBranch %>">
                                                        <input type="hidden" name="semester" value="<%= selectedSemester %>">
                                                        <button type="submit" class="btn-red"><i class="fa-solid fa-trash"></i> Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </table>
                                    <% } %>
                </section>

                <!-- ROOMS SECTION -->
                <section id="rooms" class="hidden">
                    <h2><i class="fa-solid fa-school"></i> Add Examination Room</h2>
                    <form action="/add_room" method="POST" class="room-form-compact">
                        <div style="display: flex; gap: 10px; width: 100%;">
                            <input name="room_no" placeholder="Room Number" required style="flex: 1;">
                            <input id="numColumnsInput" name="columns" type="number" min="1" max="20" placeholder="Number of Columns" required style="flex: 1;" onchange="generateColumnRowInputs()" onkeyup="generateColumnRowInputs()">
                        </div>

                        <div id="columnRowsContainer" style="display: flex; flex-direction: column; gap: 8px;"></div>
                        <div id="roomSummary" style="font-weight: bold; color: #1e3a8a; display: none; padding: 2px 0;"></div>

                        <div>
                            <button type="submit" style="width: auto; padding: 10px 25px;">Add Room</button>
                        </div>
                    </form>

                    <h2 style="margin-top: 25px;"><i class="fa-solid fa-list"></i> Room List</h2>
                    <table>
                        <tr>
                            <th>Room No</th>
                            <th>Total Columns</th>
                            <th>Column Headers & Rows</th>
                            <th>Capacity</th>
                            <th>Actions</th>
                        </tr>
                        <% rooms.forEach(room=> { %>
                            <tr>
                                <td><strong><%= room.room_no %></strong></td>
                                <td><%= room.columns %> Columns</td>
                                <td>
                                    <% if (room.column_rows && room.column_rows.length > 0) { %>
                                        <table style="margin: 0; width: auto; border-collapse: collapse; border: 1px solid #cbd5e1; background: #ffffff;">
                                            <thead>
                                                <tr style="background: #eef2ff;">
                                                    <% room.column_rows.forEach((r, index) => { %>
                                                        <th style="padding: 4px 10px; font-size: 12px; border: 1px solid #cbd5e1; text-align: center; color: #1e3a8a;">
                                                            Col <%= index + 1 %>
                                                        </th>
                                                    <% }) %>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <% room.column_rows.forEach((r) => { %>
                                                        <td style="padding: 6px 10px; font-size: 13px; border: 1px solid #cbd5e1; text-align: center; font-weight: bold;">
                                                            <%= r %> Rows
                                                        </td>
                                                    <% }) %>
                                                </tr>
                                            </tbody>
                                        </table>
                                    <% } else { %>
                                        <%= room.rows %> rows/col
                                    <% } %>
                                </td>
                                <td><span class="badge"><%= room.capacity %> Seats</span></td>
                                <td>
                                    <button type="button" class="btn-blue" style="margin-right: 5px;"
                                        onclick="openRoomLayoutModal('<%= room.id %>', '<%= room.room_no %>', '<%= room.columns %>', '<%= JSON.stringify(room.column_rows) %>', '<%= JSON.stringify(room.active_seats || []) %>', '<%= JSON.stringify(room.seat_colors || []) %>')">
                                        <i class="fa-solid fa-chair"></i> Seat Layout
                                    </button>

                                    <form action="/delete_room/<%= room.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Are you sure you want to delete Room <%= room.room_no %>?');">
                                        <button type="submit" class="btn-red"><i class="fa-solid fa-trash"></i> Delete</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </table>
                </section>

                <!-- EXAMS SECTION -->
                <section id="exams" class="hidden">
                    <h2><i class="fa-solid fa-file-pen"></i> Create Exam & Registration Range</h2>
                    
                    <form action="/add_exam" method="POST" style="flex-direction: column; gap: 15px;">
                        <div style="display: flex; gap: 10px; flex-wrap: wrap; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid #cbd5e1;">
                            <div style="flex: 1; min-width: 200px;">
                                <label style="font-weight: bold; font-size: 12px;">Select Exam Room:</label>
                                <select name="room_id" required class="select-input" style="width: 100%; margin-top: 4px;">
                                    <option value="">-- Select Room --</option>
                                    <% rooms.forEach(r=> { %>
                                        <option value="<%= r.id %>">Room <%= r.room_no %> (Capacity: <%= r.capacity %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                            <div style="flex: 1; min-width: 150px;">
                                <label style="font-weight: bold; font-size: 12px;">Exam Date:</label>
                                <input name="exam_date" type="date" required style="width: 100%; margin-top: 4px;">
                            </div>
                            <div style="flex: 1; min-width: 120px;">
                                <label style="font-weight: bold; font-size: 12px;">Start Time:</label>
                                <input name="start_time" type="time" required style="width: 100%; margin-top: 4px;">
                            </div>
                            <div style="flex: 1; min-width: 120px;">
                                <label style="font-weight: bold; font-size: 12px;">End Time:</label>
                                <input name="end_time" type="time" required style="width: 100%; margin-top: 4px;">
                            </div>
                        </div>

                        <!-- PRIMARY EXAM -->
                        <div style="background: #eff6ff; border: 2px solid #bfdbfe; padding: 12px; border-radius: 8px;">
                            <h3 style="margin-top: 0; color: #1e40af; font-size: 15px;">📘 Primary Exam Details (Color 1 - Blue Seats)</h3>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px;">
                                <input name="subject" placeholder="Subject Name" required style="flex: 2; min-width: 200px;">
                                <select name="branch" required class="select-input" style="flex: 1; min-width: 120px;">
                                    <option value="">-- Branch --</option>
                                    <option value="CSE">CSE</option>
                                    <option value="ME">ME</option>
                                    <option value="AE">AE</option>
                                    <option value="CE">CE</option>
                                    <option value="EE">EE</option>
                                    <option value="ECE">ECE</option>
                                </select>
                                <select name="semester" required class="select-input" style="flex: 1; min-width: 120px;">
                                    <option value="">-- Semester --</option>
                                    <option value="1">1st</option>
                                    <option value="2">2nd</option>
                                    <option value="3">3rd</option>
                                    <option value="4">4th</option>
                                    <option value="5">5th</option>
                                    <option value="6">6th</option>
                                </select>
                                <input type="hidden" name="seat_color" value="color1">
                            </div>

                            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; background: #ffffff; padding: 8px; border-radius: 6px; border: 1px solid #dbeafe;">
                                <div style="flex: 1; min-width: 180px;">
                                    <label style="font-weight: bold; font-size: 11px; color: #1e3a8a;">Starting Reg No (Optional):</label>
                                    <input name="start_reg_no" placeholder="e.g. 121XXXXXXX" style="width: 100%; margin-top: 2px; font-size: 12px;">
                                </div>
                                <div style="flex: 1; min-width: 180px;">
                                    <label style="font-weight: bold; font-size: 11px; color: #1e3a8a;">Stopping Reg No (Optional):</label>
                                    <input name="stop_reg_no" placeholder="e.g. 121XXXXXXX" style="width: 100%; margin-top: 2px; font-size: 12px;">
                                </div>
                            </div>
                        </div>

                        <!-- SECONDARY PARALLEL EXAM -->
                        <input type="hidden" name="second_exam_enabled" id="secondExamEnabledInput" value="false">

                        <div id="secondaryExamBox" style="display: none; background: #fef2f2; border: 2px solid #fecaca; padding: 12px; border-radius: 8px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <h3 style="margin: 0; color: #991b1b; font-size: 15px;">📕 Parallel / Secondary Exam Details (Color 2 - Red Seats)</h3>
                                <button type="button" class="btn-red" style="padding: 2px 8px; font-size: 11px;" onclick="toggleSecondaryExam(false)">Remove Second Exam</button>
                            </div>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px;">
                                <input id="subject2Input" name="subject2" placeholder="Second Subject Name" style="flex: 2; min-width: 200px;">
                                <select name="branch2" class="select-input" style="flex: 1; min-width: 120px;">
                                    <option value="">-- Branch --</option>
                                    <option value="CSE">CSE</option>
                                    <option value="ME">ME</option>
                                    <option value="AE">AE</option>
                                    <option value="CE">CE</option>
                                    <option value="EE">EE</option>
                                    <option value="ECE">ECE</option>
                                </select>
                                <select name="semester2" class="select-input" style="flex: 1; min-width: 120px;">
                                    <option value="">-- Semester --</option>
                                    <option value="1">1st</option>
                                    <option value="2">2nd</option>
                                    <option value="3">3rd</option>
                                    <option value="4">4th</option>
                                    <option value="5">5th</option>
                                    <option value="6">6th</option>
                                </select>
                                <input type="hidden" name="seat_color2" value="color2">
                            </div>

                            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; background: #ffffff; padding: 8px; border-radius: 6px; border: 1px solid #fee2e2;">
                                <div style="flex: 1; min-width: 180px;">
                                    <label style="font-weight: bold; font-size: 11px; color: #991b1b;">Starting Reg No (Optional):</label>
                                    <input name="start_reg_no2" placeholder="e.g. 121XXXXXXX" style="width: 100%; margin-top: 2px; font-size: 12px;">
                                </div>
                                <div style="flex: 1; min-width: 180px;">
                                    <label style="font-weight: bold; font-size: 11px; color: #991b1b;">Stopping Reg No (Optional):</label>
                                    <input name="stop_reg_no2" placeholder="e.g. 121XXXXXXX" style="width: 100%; margin-top: 2px; font-size: 12px;">
                                </div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 10px;">
                            <button type="submit" class="btn-green" style="padding: 10px 25px;"><i class="fa-solid fa-plus"></i> Save Exam(s)</button>
                            <button type="button" id="addSecondExamBtn" class="btn-yellow" onclick="toggleSecondaryExam(true)"><i class="fa-solid fa-code-fork"></i> Add One More Exam For Same Room (Dual Subject)</button>
                        </div>
                    </form>

                    <h2 style="margin-top: 30px;">Exam List & Seating Generation</h2>
                    <table>
                        <tr>
                            <th>Subject</th>
                            <th>Branch & Sem</th>
                            <th>Room</th>
                            <th>Range</th>
                            <th>Seat Color</th>
                            <th>Date & Time</th>
                            <th>Actions</th>
                        </tr>
                        <% exams.forEach(exam=> { const formattedDate = exam.exam_date ? new Date(exam.exam_date).toISOString().split('T')[0] : ''; const isColor2 = exam.seat_color === 'color2'; %>
                            <tr>
                                <td><strong><%= exam.subject %></strong></td>
                                <td>
                                    <div class="badge" style="text-align: center;"><%= exam.branch || 'All' %></div>
                                    Sem <%= exam.semester || 'N/A' %>
                                </td>
                                <td><strong><%= exam.room_no ? exam.room_no : 'N/A' %></strong></td>
                                <td>
                                    <% if (exam.start_reg_no && exam.stop_reg_no) { %>
                                        <small><strong><%= exam.start_reg_no %></strong> to <strong><%= exam.stop_reg_no %></strong></small>
                                    <% } else { %>
                                        <span style="color: #64748b; font-style: italic;">All Students</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (isColor2) { %>
                                        <div class="badge" style="background: #dc2626; color: white;">Red Seats</div>
                                    <% } else { %>
                                        <div class="badge" style="background: #2563eb; color: white;">Blue Seats</div>
                                    <% } %>
                                </td>
                                <td>
                                    <%= formattedDate %><br>
                                    <small><%= exam.start_time %> - <%= exam.end_time %></small>
                                </td>
                                <td>
                                    <a href="/generate_seating/<%= exam.id %>">
                                        <button type="button" class="btn-blue"><i class="fa-solid fa-shuffle"></i> Randomize Seats</button>
                                    </a>

                                    <div class="export-dropdown">
                                        <button type="button" class="btn-green"><i class="fa-solid fa-file-export"></i> Export <i class="fa-solid fa-caret-down"></i></button>
                                        <div class="export-dropdown-content">
                                            <a href="/export_seating_pdf/<%= exam.id %>" style="color: #dc2626;"><i class="fa-solid fa-file-pdf"></i> PDF File</a>
                                            <a href="/export_seating_excel/<%= exam.id %>" style="color: #16a34a;"><i class="fa-solid fa-file-excel"></i> Excel Sheet</a>
                                        </div>
                                    </div>

                                    <button type="button" class="btn-yellow"
                                        onclick="openEditExamModal('<%= exam.id %>', '<%= exam.subject %>', '<%= exam.branch %>', '<%= exam.semester %>', '<%= exam.room_id %>', '<%= exam.seat_color %>', '<%= exam.start_reg_no %>', '<%= exam.stop_reg_no %>', '<%= formattedDate %>', '<%= exam.start_time %>', '<%= exam.end_time %>')">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <form action="/delete_exam/<%= exam.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Are you sure you want to delete exam for <%= exam.subject %>?');">
                                        <button type="submit" class="btn-red"><i class="fa-solid fa-trash"></i> Delete</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </table>
                </section>

                <!-- MARKS & PAPERS SECTION -->
                <section id="marks" class="hidden">
                    <h2><i class="fa-solid fa-file-arrow-up"></i> Marks & Question Papers Management</h2>
                    <p class="select-instruction">You can Upload Question Paper, Marks(in excel), View the uploaded Question Paper, marks, and the sample excel.</p>
                    <br>

                    <% if (exams.length === 0) { %>
                        <p class="no-data-msg">No exam has been created until now.</p>
                    <% } else { %>
                        <table>
                            <tr>
                                <th>Name (Subject)</th>
                                <th>Branch & Sem</th>
                                <th>Date(yyyy/mm/dd)</th>
                                <th>Actions</th>
                            </tr>
                            <% exams.forEach(exam => { 
                                const formattedDate = exam.exam_date ? new Date(exam.exam_date).toISOString().split('T')[0] : 'N/A';
                            %>
                                <tr>
                                    <td><strong><%= exam.subject %></strong></td>
                                    <td>
                                        <span class="badge"><%= exam.branch || 'All' %></span>
                                        Sem <%= exam.semester || 'N/A' %>
                                    </td>
                                    <td><%= formattedDate %></td>
                                    <td>
                                        <button type="button" class="btn-blue" onclick="openUploadPaperModal('<%= exam.id %>', '<%= exam.subject %>')">
                                            <i class="fa-solid fa-upload"></i> Upload Paper
                                        </button>
                                        <button type="button" class="btn-green" onclick="openUploadMarksModal('<%= exam.id %>', '<%= exam.subject %>')">
                                            <i class="fa-solid fa-file-excel"></i> Upload Marks
                                        </button>
                                        <button type="button" class="btn-blue" style="background: #0284c7;" onclick="openViewMarksModal('<%= exam.id %>', '<%= exam.subject %>')">
                                            <i class="fa-solid fa-eye"></i> View Marks
                                        </button>
                                        <a href="/download_sample_marks_excel/<%= exam.id %>" style="text-decoration: none;">
                                            <button type="button" class="btn-yellow" title="Download pre-filled Excel with Seat Allotment headers, Total Marks (20), and Q1-Q9">
                                                <i class="fa-solid fa-download"></i> Sample Excel
                                            </button>
                                        </a>
                                        <% if (exam.question_paper) { %>
                                            <a href="<%= exam.question_paper %>" target="_blank" style="text-decoration: none;">
                                                <button type="button" class="btn-yellow"><i class="fa-solid fa-eye"></i> View Paper</button>
                                            </a>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </table>
                    <% } %>
                </section>

                <!-- PYQs & QUESTIONS SECTION (ADMIN) -->
                <section id="pyqs" class="hidden">
                    <h2><i class="fa-solid fa-book-open"></i> Upload PYQs & Practice Questions</h2>
                    <p class="select-instruction">To upload PYQs or Questions, first select the Branch, Semester, and Subject Name.</p>
                    <br>

                    <div class="upload-box" style="max-width: 700px; margin-bottom: 25px;">
                        <form action="/upload_pyq" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 12px;">
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                <div style="flex: 1; min-width: 150px;">
                                    <label style="font-weight: bold; font-size: 12px;">1. Branch:</label>
                                    <select name="branch" required class="select-input" style="width: 100%; margin-top: 4px;">
                                        <option value="">-- Choose Branch --</option>
                                        <option value="CSE">CSE</option>
                                        <option value="ME">ME</option>
                                        <option value="AE">AE</option>
                                        <option value="CE">CE</option>
                                        <option value="EE">EE</option>
                                        <option value="ECE">ECE</option>
                                    </select>
                                </div>
                                <div style="flex: 1; min-width: 120px;">
                                    <label style="font-weight: bold; font-size: 12px;">2. Semester:</label>
                                    <select name="semester" required class="select-input" style="width: 100%; margin-top: 4px;">
                                        <option value="">-- Semester --</option>
                                        <option value="1">1st</option>
                                        <option value="2">2nd</option>
                                        <option value="3">3rd</option>
                                        <option value="4">4th</option>
                                        <option value="5">5th</option>
                                        <option value="6">6th</option>
                                    </select>
                                </div>
                                <div style="flex: 2; min-width: 200px;">
                                    <label style="font-weight: bold; font-size: 12px;">3. Subject Name:</label>
                                    <input name="subject" placeholder="e.g. Operating Systems, DBMS" required style="width: 100%; margin-top: 4px;">
                                </div>
                            </div>

                            <div>
                                <label style="font-weight: bold; font-size: 12px;">4. Paper / Question Title:</label>
                                <input name="title" placeholder="e.g. End Semester PYQ 2024, Unit 1 Important Questions" required style="width: 100%; margin-top: 4px;">
                            </div>

                            <div>
                                <label style="font-weight: bold; font-size: 12px;">5. Select Document / Image / PDF:</label>
                                <input type="file" name="pyq_file" accept=".pdf, .png, .jpg, .jpeg, .doc, .docx" required style="width: 100%; margin-top: 4px;">
                            </div>

                            <div>
                                <button type="submit" class="btn-green" style="padding: 10px 25px;"><i class="fa-solid fa-cloud-arrow-up"></i> Upload Question</button>
                            </div>
                        </form>
                    </div>

                    <h2><i class="fa-solid fa-list-check"></i> Uploaded PYQs & Questions (<%= pyqs.length %> Total)</h2>
                    <% if (pyqs.length === 0) { %>
                        <p class="no-data-msg">No PYQs or Questions have been uploaded yet.</p>
                    <% } else { %>
                        <table>
                            <tr>
                                <th>Title</th>
                                <th>Subject</th>
                                <th>Branch & Sem</th>
                                <th>Uploaded Date</th>
                                <th>Actions</th>
                            </tr>
                            <% pyqs.forEach(p => { %>
                                <tr>
                                    <td><strong><%= p.title %></strong></td>
                                    <td><%= p.subject %></td>
                                    <td>
                                        <span class="badge"><%= p.branch %></span>
                                        Sem <%= p.semester %>
                                    </td>
                                    <td><%= new Date(p.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <a href="<%= p.file_url %>" target="_blank" style="text-decoration: none;">
                                            <button type="button" class="btn-blue"><i class="fa-solid fa-eye"></i> View</button>
                                        </a>
                                        <form action="/delete_pyq/<%= p.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Delete this question paper?');">
                                            <button type="submit" class="btn-red"><i class="fa-solid fa-trash"></i> Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </table>
                    <% } %>
                </section>

                <!-- ADMIN CHAT & POLL FEATURE SECTION -->
                <section id="admin_chat" class="hidden">
                    <h2><i class="fa-solid fa-comments"></i> Admin Class Chat & Polls</h2>
                    <p class="select-instruction">First select Branch aur Semester to enter in the chat section of a particular Branch and Semester.</p>
                    
                    <div style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
                        <div>
                            <label style="font-weight: bold; font-size: 13px;">Branch:</label>
                            <select id="adminChatBranch" class="select-input" onchange="initAdminChatRoom()">
                                <option value="">-- Choose Branch --</option>
                                <option value="CSE">CSE</option>
                                <option value="ME">ME</option>
                                <option value="AE">AE</option>
                                <option value="CE">CE</option>
                                <option value="EE">EE</option>
                                <option value="ECE">ECE</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-weight: bold; font-size: 13px;">Semester:</label>
                            <select id="adminChatSemester" class="select-input" onchange="initAdminChatRoom()">
                                <option value="">-- Choose Semester --</option>
                                <option value="1">1st</option>
                                <option value="2">2nd</option>
                                <option value="3">3rd</option>
                                <option value="4">4th</option>
                                <option value="5">5th</option>
                                <option value="6">6th</option>
                            </select>
                        </div>
                        <span id="adminChatStatus" style="font-size: 13px; font-weight: bold; color: #64748b;">First select the Branch and Semester.</span>
                    </div>

                    <div id="adminChatWrapper" class="hidden">
                        <!-- Create Poll Box -->
                        <div style="background: #fdf2f8; border: 1px solid #fbcfe8; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                            <h3 style="margin-top: 0; color: #9d174d;"><i class="fa-solid fa-square-poll-horizontal"></i> Create a New Poll for this Class</h3>
                            <div style="display: flex; flex-direction: column; gap: 10px;">
                                <input id="newPollQuestion" placeholder="Enter poll question (e.g. Which topic needs a revision session?)" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px;">
                                <div id="pollOptionsContainer" style="display: flex; flex-direction: column; gap: 6px;">
                                    <input class="poll-option-input" placeholder="Option 1" style="padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                                    <input class="poll-option-input" placeholder="Option 2" style="padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                                </div>
                                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                                    <button type="button" class="btn-blue" style="font-size: 11px; padding: 4px 8px;" onclick="addPollOptionInput()">+ Add Another Option</button>
                                    <label style="font-size: 13px; font-weight: bold; color: #1e293b; margin-left: 10px;">
                                        <input type="checkbox" id="pollIsMultiple"> Allow Multiple Choices (Multi-option poll)
                                    </label>
                                    <button type="button" class="btn-green" style="margin-left: auto; padding: 8px 18px;" onclick="submitCreatePoll()"><i class="fa-solid fa-paper-plane"></i> Publish Poll</button>
                                </div>
                            </div>
                        </div>

                        <!-- Grid: Polls Feed & Chat Box -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <!-- Active Polls List -->
                            <div>
                                <h3 style="margin-top: 0; color: #1e3a8a;"><i class="fa-solid fa-chart-simple"></i> Class Polls (Active 48h)</h3>
                                <div id="adminPollsList" style="max-height: 500px; overflow-y: auto;">
                                    <p style="color: #64748b; font-style: italic;">Loading polls...</p>
                                </div>
                            </div>

                            <!-- Live Chat -->
                            <div>
                                <h3 style="margin-top: 0; color: #1e3a8a;"><i class="fa-solid fa-message"></i> Class Chat (Auto-Deletes in 24h)</h3>
                                <div class="chat-container">
                                    <div class="chat-messages" id="adminChatMessages">
                                        <!-- Messages loaded dynamically -->
                                    </div>
                                    <div class="chat-input-bar">
                                        <input id="adminMsgInput" placeholder="Type a message to the students..." style="flex: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px;" onkeypress="handleAdminChatKey(event)">
                                        <button type="button" class="btn-blue" onclick="sendAdminMessage()"><i class="fa-solid fa-paper-plane"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ADMIN & USERS SECTION -->
                <section id="admin_users" class="hidden">
                    <h2><i class="fa-solid fa-user-shield"></i> Existing Admin Accounts (<%= adminUsers.length %> Total)</h2>
                    
                    <table>
                        <tr>
                            <th>Admin Username</th>
                            <th>Role</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                        <% adminUsers.forEach(a=> { %>
                            <tr>
                                <td><strong><%= a.username %></strong></td>
                                <td><span class="badge">ADMIN</span></td>
                                <td><%= new Date(a.created_at).toLocaleDateString() %></td>
                                <td>
                                    <% if (a.id !==user.id) { %>
                                        <form action="/delete_admin/<%= a.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Are you sure you want to delete Admin <%= a.username %>?');">
                                            <input type="hidden" name="user_search" value="<%= userSearchQuery %>">
                                            <button type="submit" class="btn-red"><i class="fa-solid fa-trash"></i> Delete Admin</button>
                                        </form>
                                        <% } else { %>
                                            <span style="color: #64748b; font-style: italic;">(Current Account)</span>
                                            <% } %>
                                </td>
                            </tr>
                            <% }) %>
                    </table>

                    <br>
                    <hr><br>

                    <h2><i class="fa-solid fa-magnifying-glass"></i> Search User to Give Admin Role</h2>
                    <p class="select-instruction">Enter a Username to search for a registered account and make them Admin.</p>

                    <form action="/" method="GET" style="display: flex; gap: 10px; margin-bottom: 20px;">
                        <input type="hidden" name="active_tab" value="admin_users">
                        <input name="user_search" placeholder="Enter Username" value="<%= userSearchQuery %>" required style="flex: 1;">
                        <button type="submit" class="btn-blue"><i class="fa-solid fa-search"></i> Search User</button>
                        <% if (userSearchQuery) { %>
                            <a href="/?active_tab=admin_users" class="btn-clear-filter" style="display: inline-flex; align-items: center; justify-content: center;">Clear Search</a>
                            <% } %>
                    </form>

                    <% if (userSearchQuery) { %>
                        <h3>Search Results for "<%= userSearchQuery %>":</h3>
                        <% if (searchedUsers.length===0) { %>
                            <p class="no-data-msg">No user found matching username "<%= userSearchQuery %>".</p>
                            <% } else { %>
                                <table>
                                    <tr>
                                        <th>ID</th>
                                        <th>Username</th>
                                        <th>Current Role</th>
                                        <th>Actions</th>
                                    </tr>
                                    <% searchedUsers.forEach(u=> { %>
                                        <tr>
                                            <td><%= u.id %></td>
                                            <td><%= u.username %></td>
                                            <td><strong style="text-transform: uppercase;"><%= u.role %></strong></td>
                                            <td>
                                                <% if (u.role==='admin' ) { %>
                                                    <span class="badge">Already Admin</span>
                                                    <% } else { %>
                                                        <form action="/make_admin/<%= u.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Promote <%= u.username %> to Admin?');">
                                                            <input type="hidden" name="user_search" value="<%= userSearchQuery %>">
                                                            <button type="submit" class="btn-blue"><i class="fa-solid fa-user-gear"></i> Make Admin</button>
                                                        </form>
                                                        <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </table>
                                <% } %>
                                    <% } %>
                </section>

                <% } else { %>

                    <!-- STUDENT VIEW: SEATING -->
                    <section id="my_seating">
                        <h2>💺 My Assigned Exam Seats</h2>
                        <% if (studentSeating.length===0) { %>
                            <p class="no-data-msg">No seating arrangements generated for your exams yet. Check back once the admin generates the plan.</p>
                            <% } else { %>
                                <table>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Date</th>
                                        <th>Timing</th>
                                        <th>Room No</th>
                                        <th>Column</th>
                                        <th>Row (Bench)</th>
                                        <th>Assigned Seat</th>
                                    </tr>
                                    <% studentSeating.forEach(s=> { %>
                                        <tr>
                                            <td><strong><%= s.subject %></strong></td>
                                            <td><%= new Date(s.exam_date).toISOString().split('T')[0] %></td>
                                            <td><%= s.start_time %> - <%= s.end_time %></td>
                                            <td><%= s.room_no %></td>
                                            <td>Column <%= s.column_no %></td>
                                            <td>Bench <%= s.row_no %></td>
                                            <td><span class="badge"><%= s.seat_no %></span></td>
                                        </tr>
                                        <% }) %>
                                </table>
                                <% } %>
                    </section>

                    <!-- STUDENT VIEW: MY EXAMS & MARKS -->
                    <section id="my_exams_marks" class="hidden">
                        <h2><i class="fa-solid fa-square-poll-vertical"></i> My Exams, Question Papers & Marks</h2>
                        <% if (!studentExamsWithMarks || studentExamsWithMarks.length === 0) { %>
                            <p class="no-data-msg">No exam or marks records available yet for your branch and semester.</p>
                        <% } else { %>
                            <table>
                                <tr>
                                    <th>Subject</th>
                                    <th>Date & Timing</th>
                                    <th>Question Paper</th>
                                    <th>My Marks & Breakdown</th>
                                </tr>
                                <% studentExamsWithMarks.forEach(e => { %>
                                    <tr>
                                        <td><strong><%= e.subject %></strong></td>
                                        <td><%= e.exam_date %><br><small><%= e.start_time %> - <%= e.end_time %></small></td>
                                        <td>
                                            <% if (e.question_paper) { %>
                                                <a href="<%= e.question_paper %>" target="_blank" style="text-decoration: none;">
                                                    <button type="button" class="btn-blue" style="padding: 5px 12px; font-size: 12px;">
                                                        <i class="fa-solid fa-download"></i> Download Paper
                                                    </button>
                                                </a>
                                            <% } else { %>
                                                <span style="color: #94a3b8; font-style: italic;">Not Uploaded Yet</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (e.marks !== null && e.marks !== undefined) { %>
                                                <span class="badge" style="background: #16a34a; color: white; font-size: 13px; padding: 6px 12px;">
                                                    Total: <%= e.marks %> / <%= e.total_marks %>
                                                </span>

                                                <% if (e.question_wise_marks && Object.keys(e.question_wise_marks).length > 0) { %>
                                                    <div style="margin-top: 8px; display: flex; flex-wrap: wrap; gap: 5px;">
                                                        <% Object.entries(e.question_wise_marks).forEach(([q, val]) => { %>
                                                            <span style="background: #e2e8f0; color: #1e293b; padding: 2px 7px; border-radius: 4px; font-size: 11px; font-weight: bold; border: 1px solid #cbd5e1;">
                                                                <%= q %>: <%= val %>
                                                            </span>
                                                        <% }) %>
                                                    </div>
                                                <% } %>
                                            <% } else { %>
                                                <span style="color: #94a3b8; font-style: italic;">Not Published</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </table>
                        <% } %>
                    </section>

                    <!-- STUDENT VIEW: PYQs & QUESTIONS -->
                    <section id="student_pyqs" class="hidden">
                        <h2><i class="fa-solid fa-book-open"></i> PYQs & Practice Questions</h2>
                        
                        <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                            <div>
                                <span style="color: #1e3a8a; font-weight: bold;">Branch:</span> <span class="badge"><%= studentInfo ? studentInfo.branch : 'N/A' %></span>
                                &nbsp;&nbsp;
                                <span style="color: #1e3a8a; font-weight: bold;">Semester:</span> <span class="badge"><%= studentInfo ? studentInfo.semester + 'th' : 'N/A' %></span>
                            </div>

                            <div style="display: flex; align-items: center; gap: 10px;">
                                <label style="font-weight: bold; font-size: 13px; color: #1e3a8a;">Filter by Subject:</label>
                                <select id="studentSubjectFilter" onchange="filterStudentPyqs()" class="select-input" style="min-width: 180px;">
                                    <option value="">-- All Subjects --</option>
                                    <% studentSubjects.forEach(sub => { %>
                                        <option value="<%= sub %>"><%= sub %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>

                        <% if (studentPyqs.length === 0) { %>
                            <p class="no-data-msg">No questions have been uploaded for your branch and semester yet.</p>
                        <% } else { %>
                            <table>
                                <tr>
                                    <th style="width: 70px; text-align: center;">Done?</th>
                                    <th>Question / PYQ Title</th>
                                    <th>Subject</th>
                                    <th>Download / View</th>
                                    <th>Status</th>
                                </tr>
                                <% studentPyqs.forEach(p => { %>
                                    <tr class="student-pyq-row" data-subject="<%= p.subject.toLowerCase() %>">
                                        <td style="text-align: center;">
                                            <input type="checkbox" id="chk_pyq_<%= p.id %>" <%= p.is_completed ? 'checked' : '' %> 
                                                   onchange="togglePyqProgress('<%= p.id %>', this)" 
                                                   style="width: 20px; height: 20px; cursor: pointer; accent-color: #16a34a;"
                                                   title="Mark as done / Undo">
                                        </td>
                                        <td><strong><%= p.title %></strong></td>
                                        <td><span class="badge"><%= p.subject %></span></td>
                                        <td>
                                            <a href="<%= p.file_url %>" target="_blank" style="text-decoration: none;">
                                                <button type="button" class="btn-blue" style="padding: 5px 12px; font-size: 12px;">
                                                    <i class="fa-solid fa-download"></i> View / Download
                                                </button>
                                            </a>
                                        </td>
                                        <td>
                                            <% if (p.is_completed) { %>
                                                <span id="status_pyq_<%= p.id %>" class="badge" style="background: #16a34a; color: white;">Completed</span>
                                            <% } else { %>
                                                <span id="status_pyq_<%= p.id %>" class="badge" style="background: #94a3b8; color: white;">Pending</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </table>
                            <p id="noSubjectPyqMsg" class="no-data-msg hidden" style="text-align: center; margin-top: 15px;">Selected subject ke liye koi question nahi mila.</p>
                        <% } %>
                    </section>

                    <!-- STUDENT VIEW: CHAT & LIVE POLLS (INSTANT VOTE WITHOUT SUBMIT BUTTON) -->
                    <section id="student_chat" class="hidden">
                        <h2><i class="fa-solid fa-comments"></i> Class Chat & Live Polls</h2>
                        <% if (!studentInfo || !studentInfo.branch || !studentInfo.semester) { %>
                            <p class="no-data-msg">Your student profile is incomplete. A valid branch and semester are required to access the chat feature.</p>
                        <% } else { %>
                            <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 10px 15px; border-radius: 8px; margin-bottom: 15px;">
                                💬 <strong>Active Room:</strong> <%= studentInfo.branch %> (Semester <%= studentInfo.semester %>) — 
                                <small style="color: #64748b;">(Chat auto-deletes in 24h, Polls in 48h)</small>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                                <!-- Polls Box for Student -->
                                <div>
                                    <h3 style="margin-top: 0; color: #1e3a8a;"><i class="fa-solid fa-square-poll-horizontal"></i> Active Polls</h3>
                                    <div id="studentPollsList" style="max-height: 500px; overflow-y: auto;">
                                        <p style="color: #64748b; font-style: italic;">Loading polls...</p>
                                    </div>
                                </div>

                                <!-- Chat Box for Student -->
                                <div>
                                    <h3 style="margin-top: 0; color: #1e3a8a;"><i class="fa-solid fa-message"></i> Class Conversation</h3>
                                    <div class="chat-container">
                                        <div class="chat-messages" id="studentChatMessages">
                                            <!-- Messages loaded dynamically -->
                                        </div>
                                        <div class="chat-input-bar">
                                            <input id="studentMsgInput" placeholder="Type a message..." style="flex: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px;" onkeypress="handleStudentChatKey(event)">
