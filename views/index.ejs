                                            <%= m.is_multiple ? 'Multi-Option' : 'Single-Option' %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge"><%= m.branch %></span><br>
                                        Sem <%= m.semester %><br>
                                        <small style="color: #1e3a8a; font-weight: bold;"><%= m.total_votes %> Votes</small>
                                    </td>
