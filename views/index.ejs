        // --- STUDENT CHAT & POLL FUNCTIONS ---

        let studentBranch = '<%= studentInfo ? studentInfo.branch : "" %>';
        let studentSemester = '<%= studentInfo ? studentInfo.semester : "" %>';

        function initStudentChat() {
            if (!studentBranch || !studentSemester) return;
            loadStudentChatData();
            if (chatPollInterval) clearInterval(chatPollInterval);
            chatPollInterval = setInterval(loadStudentChatData, 3000);
        }

        async function loadStudentChatData() {
            if (!studentBranch || !studentSemester) return;
            try {
                const res = await fetch(`/api/chat/${studentBranch}/${studentSemester}`);
                const data = await res.json();
                if (data.success) {
                    renderStudentMessages(data.messages);
                    renderStudentPolls(data.polls);
                }
            } catch (err) {
                console.error(err);
            }
        }

        function renderStudentMessages(messages) {
            const container = document.getElementById('studentChatMessages');
            if (!container) return;
            const atBottom = container.scrollHeight - container.scrollTop <= container.clientHeight + 50;

            container.innerHTML = '';
            if (messages.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: #94a3b8; font-style: italic;">No messages yet. (Auto-deletes in 24 hours)</p>';
                return;
            }

            const currentUsername = '<%= user.username %>';

            messages.forEach(m => {
                const div = document.createElement('div');
                const isMe = m.sender_username === currentUsername;
                div.className = isMe ? 'chat-bubble chat-bubble-me' : (m.sender_role === 'admin' ? 'chat-bubble chat-bubble-admin' : 'chat-bubble chat-bubble-student');
                
                const senderTitle = m.sender_role === 'student'
                    ? `${m.sender_name}`
                    : `${m.sender_name} <span class="badge" style="font-size:9px; background:#1e40af; color:white;">ADMIN</span>`;

                div.innerHTML = `
                    <div style="font-weight: bold; font-size: 11px; margin-bottom: 2px; color: ${isMe ? '#dbeafe' : (m.sender_role === 'admin' ? '#1e40af' : '#0f172a')};">
                        ${senderTitle}
                        <span style="font-weight: normal; font-size: 10px; opacity: 0.8; margin-left: 6px;">${new Date(m.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                    </div>
                    <div>${m.message}</div>
                `;
                container.appendChild(div);
            });

            if (atBottom) container.scrollTop = container.scrollHeight;
        }

        function renderStudentPolls(polls) {
            const container = document.getElementById('studentPollsList');
            if (!container) return;
            container.innerHTML = '';

            if (polls.length === 0) {
                container.innerHTML = '<p style="color: #64748b; font-style: italic;">No active polls. (Auto-deletes in 48 hours)</p>';
                return;
            }

            polls.forEach(p => {
                const div = document.createElement('div');
                div.className = 'poll-card';

                let optionsHtml = '';

                p.options.forEach(opt => {
                    const isSelected = p.has_voted && p.user_votes.includes(opt.option_id);
                    const pct = p.total_voters > 0 ? Math.round((opt.votes_count / p.total_voters) * 100) : 0;

                    if (p.has_voted) {
                        optionsHtml += `
                            <div class="poll-option-row" style="${isSelected ? 'border-color: #16a34a; background: #f0fdf4;' : ''}">
                                <span style="font-size: 13px; font-weight: bold; flex: 1;">
                                    ${isSelected ? '✓ ' : ''}${opt.text}
                                </span>
                                <div class="poll-progress-bg" style="max-width: 140px;">
                                    <div class="poll-progress-fill" style="width: ${pct}%; background: ${isSelected ? '#16a34a' : '#2563eb'};"></div>
                                </div>
                                <span style="font-size: 12px; font-weight: bold; color: #1e3a8a;">${opt.votes_count} votes (${pct}%)</span>
                            </div>
                        `;
                    } else {
                        optionsHtml += `
                            <div class="poll-option-row poll-option-interactive" onclick="submitStudentInstantVote('${p.id}', ${opt.option_id})">
                                <span style="font-size: 13px; font-weight: bold; color: #1e293b;"><i class="fa-regular fa-circle" style="color: #2563eb; margin-right: 8px;"></i> ${opt.text}</span>
                            </div>
                        `;
                    }
                });

                let footerHtml = '';
                if (p.has_voted) {
                    footerHtml = `<div style="margin-top: 8px; font-size: 12px; color: #16a34a; font-weight: bold;"><i class="fa-solid fa-lock"></i> Your vote has been recorded. (Locked)</div>`;
                } else {
                    footerHtml = `<div style="margin-top: 8px; font-size: 12px; color: #64748b; font-style: italic;">💡 Click any option to submit your vote instantly.</div>`;
                }

                div.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                        <h4 style="margin: 0; color: #0f172a; font-size: 14px;">${p.question}</h4>
                        <span class="badge" style="font-size: 10px; background: ${p.is_multiple ? '#9333ea' : '#2563eb'}; color: white;">
                            ${p.is_multiple ? 'Multi-Choice' : 'Single-Choice'}
                        </span>
                    </div>
                    <div style="margin-top: 10px;">${optionsHtml}</div>
                    ${footerHtml}
                `;
                container.appendChild(div);
            });
        }

        async function submitStudentInstantVote(pollId, optionId) {
            try {
                const res = await fetch('/api/poll/vote', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ poll_id: pollId, selected_options: [optionId] })
                });
                const data = await res.json();
                if (data.success) {
                    loadStudentChatData();
                } else {
                    alert(data.message || 'Error submitting vote');
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function sendStudentMessage() {
            const input = document.getElementById('studentMsgInput');
            const msg = input.value.trim();
            if (!msg || !studentBranch || !studentSemester) return;

            try {
                const res = await fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        branch: studentBranch,
                        semester: studentSemester,
                        message: msg
                    })
                });
                const data = await res.json();
                if (data.success) {
                    input.value = '';
                    loadStudentChatData();
                }
            } catch (err) {
