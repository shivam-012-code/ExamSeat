    <script>
        let currentBrushColor = 'color1';
        let roomSeatState = {};
        let activeAdminChatBranch = '';
        let activeAdminChatSemester = '';
        let chatPollInterval = null;

        // --- ADMIN CHAT & POLL FUNCTIONS ---

        function initAdminChatRoom() {
            activeAdminChatBranch = document.getElementById('adminChatBranch').value;
            activeAdminChatSemester = document.getElementById('adminChatSemester').value;

            if (activeAdminChatBranch && activeAdminChatSemester) {
                document.getElementById('adminChatStatus').innerText = `Connected to ${activeAdminChatBranch} - Semester ${activeAdminChatSemester}`;
                document.getElementById('adminChatStatus').style.color = '#16a34a';
                document.getElementById('adminChatWrapper').classList.remove('hidden');

                loadAdminChatData();
                if (chatPollInterval) clearInterval(chatPollInterval);
                chatPollInterval = setInterval(loadAdminChatData, 3000);
            } else {
                document.getElementById('adminChatWrapper').classList.add('hidden');
                document.getElementById('adminChatStatus').innerText = 'Select the Branch and Semester first.';
                document.getElementById('adminChatStatus').style.color = '#64748b';
                if (chatPollInterval) clearInterval(chatPollInterval);
            }
        }

        async function loadAdminChatData() {
            if (!activeAdminChatBranch || !activeAdminChatSemester) return;

            try {
                const res = await fetch(`/api/chat/${activeAdminChatBranch}/${activeAdminChatSemester}`);
                const data = await res.json();
                if (data.success) {
                    renderAdminMessages(data.messages);
                    renderAdminPolls(data.polls);
                }
            } catch (err) {
                console.error(err);
            }
        }

        function renderAdminMessages(messages) {
            const container = document.getElementById('adminChatMessages');
            const atBottom = container.scrollHeight - container.scrollTop <= container.clientHeight + 50;

            container.innerHTML = '';
            if (messages.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: #94a3b8; font-style: italic;">No messages yet. (Auto-deletes in 24 hours)</p>';
                return;
            }

            messages.forEach(m => {
                const div = document.createElement('div');
                div.className = m.sender_role === 'admin' ? 'chat-bubble chat-bubble-admin' : 'chat-bubble chat-bubble-student';
                
                // Show Student Name AND Registration Number
                const senderTitle = m.sender_role === 'student'
                    ? `${m.sender_name}`
                    : `${m.sender_name} <span class="badge" style="font-size:9px; background:#1e40af; color:white;">ADMIN</span>`;

                div.innerHTML = `
                    <div style="font-weight: bold; font-size: 11px; margin-bottom: 2px; color: ${m.sender_role === 'admin' ? '#1e40af' : '#0f172a'};">
                        ${senderTitle}
                        <span style="font-weight: normal; font-size: 10px; color: #64748b; margin-left: 6px;">${new Date(m.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                    </div>
                    <div>${m.message}</div>
                `;
                container.appendChild(div);
            });

            if (atBottom) container.scrollTop = container.scrollHeight;
        }

        function renderAdminPolls(polls) {
            const container = document.getElementById('adminPollsList');
            container.innerHTML = '';

            if (polls.length === 0) {
                container.innerHTML = '<p style="color: #64748b; font-style: italic;">No active polls. (Auto-deletes in 48 hours)</p>';
                return;
            }

            polls.forEach(p => {
                const div = document.createElement('div');
                div.className = 'poll-card';

                let optionsHtml = '';
                p.options.forEach(opt => {
                    const pct = p.total_voters > 0 ? Math.round((opt.votes_count / p.total_voters) * 100) : 0;
                    optionsHtml += `
                        <div class="poll-option-row">
                            <span style="font-weight: bold; font-size: 13px; min-width: 100px;">${opt.text}</span>
                            <div class="poll-progress-bg">
                                <div class="poll-progress-fill" style="width: ${pct}%;"></div>
                            </div>
                            <span style="font-size: 12px; font-weight: bold; color: #1e3a8a;">${opt.votes_count} votes (${pct}%)</span>
                        </div>
                    `;
                });

                div.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                        <h4 style="margin: 0; color: #0f172a; font-size: 14px;">${p.question}</h4>
                        <span class="badge" style="font-size: 10px; background: ${p.is_multiple ? '#9333ea' : '#2563eb'}; color: white;">
                            ${p.is_multiple ? 'Multi-Choice' : 'Single-Choice'}
                        </span>
                    </div>
                    <small style="color: #64748b;">Total Voters: <strong>${p.total_voters}</strong> • Expires in 48h</small>
                    <div style="margin-top: 10px;">${optionsHtml}</div>
                    <div style="text-align: right; margin-top: 10px;">
                        <button type="button" class="btn-blue" style="font-size: 11px; padding: 4px 10px;" onclick="openInspectVotersModal('${p.id}')">
                            <i class="fa-solid fa-users-viewfinder"></i> Inspect Voters
                        </button>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        async function sendAdminMessage() {
            const input = document.getElementById('adminMsgInput');
            const msg = input.value.trim();
            if (!msg || !activeAdminChatBranch || !activeAdminChatSemester) return;

            try {
                const res = await fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        branch: activeAdminChatBranch,
                        semester: activeAdminChatSemester,
                        message: msg
                    })
                });
                const data = await res.json();
                if (data.success) {
                    input.value = '';
                    loadAdminChatData();
                }
            } catch (err) {
                console.error(err);
            }
        }

        function handleAdminChatKey(e) {
            if (e.key === 'Enter') sendAdminMessage();
        }

        function addPollOptionInput() {
            const container = document.getElementById('pollOptionsContainer');
            const count = container.querySelectorAll('input').length + 1;
            const input = document.createElement('input');
            input.className = 'poll-option-input';
            input.placeholder = `Option ${count}`;
            input.style = "padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px;";
            container.appendChild(input);
        }

        async function submitCreatePoll() {
            const question = document.getElementById('newPollQuestion').value.trim();
            const optionInputs = document.querySelectorAll('.poll-option-input');
            const options = Array.from(optionInputs).map(i => i.value.trim()).filter(v => v.length > 0);
            const isMultiple = document.getElementById('pollIsMultiple').checked;

            if (!question) {
                alert('Please enter a poll question.');
                return;
            }
            if (options.length < 2) {
                alert('Please enter at least 2 valid options.');
                return;
            }

            try {
                const res = await fetch('/api/poll/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        branch: activeAdminChatBranch,
                        semester: activeAdminChatSemester,
                        question,
                        options,
                        is_multiple: isMultiple
                    })
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('newPollQuestion').value = '';
                    optionInputs.forEach(i => i.value = '');
                    document.getElementById('pollIsMultiple').checked = false;
                    loadAdminChatData();
                } else {
                    alert(data.message || 'Error creating poll');
                }
            } catch (err) {
                console.error(err);
            }
        }

        // --- INSPECT VOTERS MODAL ---

        async function openInspectVotersModal(pollId) {
            document.getElementById('inspectVotersModal').classList.remove('hidden');
            document.getElementById('inspectVotersLoading').classList.remove('hidden');
            document.getElementById('inspectVotersContent').classList.add('hidden');
            document.getElementById('inspectVotersNoData').classList.add('hidden');
            document.getElementById('inspectVotersTableBody').innerHTML = '';

            try {
                const res = await fetch('/api/poll/voters/' + pollId);
                const data = await res.json();
                document.getElementById('inspectVotersLoading').classList.add('hidden');
                document.getElementById('inspectVotersContent').classList.remove('hidden');

                if (data.success) {
                    document.getElementById('inspectModalQuestion').innerText = `"${data.question}" (${data.is_multiple ? 'Multi-Choice' : 'Single-Choice'})`;

                    if (data.voters && data.voters.length > 0) {
                        const tbody = document.getElementById('inspectVotersTableBody');
                        data.voters.forEach(v => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td><strong>${v.reg_no}</strong></td>
                                <td>${v.name}</td>
                                <td>
                                    ${v.chosen_options.map(opt => `<span class="badge" style="background:#2563eb; color:white; margin: 2px;">${opt}</span>`).join(' ')}
                                </td>
                                <td>${new Date(v.voted_at).toLocaleString()}</td>
                            `;
                            tbody.appendChild(tr);
