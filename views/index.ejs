                        <span id="adminChatStatus" style="font-size: 13px; font-weight: bold; color: #64748b;">First select the Branch and Semester.</span>
                    </div>

                    <div id="adminChatWrapper" class="hidden">
                        <div style="background: #fdf2f8; border: 1px solid #fbcfe8; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                            <h3 style="margin-top: 0; color: #9d174d;"><i class="fa-solid fa-square-poll-horizontal"></i> Create a New Poll for this Class</h3>
                            <div style="display: flex; flex-direction: column; gap: 10px;">
                                <input id="newPollQuestion" placeholder="Enter poll question (e.g. Which topic needs a revision session?)" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px;">
                                <div id="pollOptionsContainer" style="display: flex; flex-direction: column; gap: 6px;">
                                    <input class="poll-option-input" placeholder="Option 1" style="padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                                    <input class="poll-option-input" placeholder="Option 2" style="padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                                </div>
                                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                                    <button type="button" class="btn-blue" style="font-size: 11px; padding: 4px 8px;" onclick="addPollOptionInput()">+ Add Another Option</button>
                                    <label style="font-size: 13px; font-weight: bold; color: #1e293b; margin-left: 10px;">
                                        <input type="checkbox" id="pollIsMultiple"> Allow Multiple Choices (Multi-option poll)
                                    </label>
                                    <button type="button" class="btn-green" style="margin-left: auto; padding: 8px 18px;" onclick="submitCreatePoll()"><i class="fa-solid fa-paper-plane"></i> Publish Poll</button>
                                </div>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div>
                                <h3 style="margin-top: 0; color: #1e3a8a;"><i class="fa-solid fa-chart-simple"></i> Class Polls (Active 48h)</h3>
                                <div id="adminPollsList" style="max-height: 500px; overflow-y: auto;">
                                    <p style="color: #64748b; font-style: italic;">Loading polls...</p>
                                </div>
                            </div>

                            <div>
                                <h3 style="margin-top: 0; color: #1e3a8a;"><i class="fa-solid fa-message"></i> Class Chat (Auto-Deletes in 24h)</h3>
                                <div class="chat-container">
                                    <div class="chat-messages" id="adminChatMessages"></div>
                                    <div class="chat-input-bar">
                                        <input id="adminMsgInput" placeholder="Type a message to the students..." style="flex: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px;" onkeypress="handleAdminChatKey(event)">
                                        <button type="button" class="btn-blue" onclick="sendAdminMessage()"><i class="fa-solid fa-paper-plane"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ADMIN & USERS SECTION -->
                <section id="admin_users" class="hidden">
                    <h2><i class="fa-solid fa-user-shield"></i> Existing Admin Accounts (<%= adminUsers.length %> Total)</h2>
                    
                    <table>
                        <tr>
                            <th>Admin Username</th>
                            <th>Role</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                        <% adminUsers.forEach(a=> { %>
                            <tr>
                                <td><strong><%= a.username %></strong></td>
                                <td><span class="badge">ADMIN</span></td>
                                <td><%= new Date(a.created_at).toLocaleDateString() %></td>
                                <td>
                                    <% if (a.id !==user.id) { %>
                                        <form action="/delete_admin/<%= a.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Are you sure you want to delete Admin <%= a.username %>?');">
                                            <input type="hidden" name="user_search" value="<%= userSearchQuery %>">
                                            <button type="submit" class="btn-red"><i class="fa-solid fa-trash"></i> Delete Admin</button>
                                        </form>
                                    <% } else { %>
                                        <span style="color: #64748b; font-style: italic;">(Current Account)</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </table>

                    <br>
                    <hr><br>

                    <h2><i class="fa-solid fa-magnifying-glass"></i> Search User to Give Admin Role</h2>
                    <p class="select-instruction">Enter a Username to search for a registered account and make them Admin.</p>

                    <form action="/" method="GET" style="display: flex; gap: 10px; margin-bottom: 20px;">
                        <input type="hidden" name="active_tab" value="admin_users">
                        <input name="user_search" placeholder="Enter Username" value="<%= userSearchQuery %>" required style="flex: 1;">
                        <button type="submit" class="btn-blue"><i class="fa-solid fa-search"></i> Search User</button>
                        <% if (userSearchQuery) { %>
                            <a href="/?active_tab=admin_users" class="btn-clear-filter" style="display: inline-flex; align-items: center; justify-content: center;">Clear Search</a>
                        <% } %>
                    </form>

                    <% if (userSearchQuery) { %>
                        <h3>Search Results for "<%= userSearchQuery %>":</h3>
                        <% if (searchedUsers.length===0) { %>
                            <p class="no-data-msg">No user found matching username "<%= userSearchQuery %>".</p>
                        <% } else { %>
                            <table>
                                <tr>
                                    <th>ID</th>
                                    <th>Username</th>
                                    <th>Current Role</th>
                                    <th>Actions</th>
                                </tr>
                                <% searchedUsers.forEach(u=> { %>
                                    <tr>
                                        <td><%= u.id %></td>
                                        <td><%= u.username %></td>
                                        <td><strong style="text-transform: uppercase;"><%= u.role %></strong></td>
                                        <td>
                                            <% if (u.role==='admin' ) { %>
                                                <span class="badge">Already Admin</span>
                                            <% } else { %>
                                                <form action="/make_admin/<%= u.id %>" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Promote <%= u.username %> to Admin?');">
                                                    <input type="hidden" name="user_search" value="<%= userSearchQuery %>">
                                                    <button type="submit" class="btn-blue"><i class="fa-solid fa-user-gear"></i> Make Admin</button>
                                                </form>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </table>
                        <% } %>
                    <% } %>
                </section>

            <% } else { %>

                <!-- STUDENT VIEW: SEATING -->
                <section id="my_seating">
                    <h2>💺 My Assigned Exam Seats</h2>
                    <% if (studentSeating.length===0) { %>
                        <p class="no-data-msg">No seating arrangements generated for your exams yet. Check back once the admin generates the plan.</p>
                    <% } else { %>
                        <table>
                            <tr>
                                <th>Subject</th>
                                <th>Date</th>
                                <th>Timing</th>
                                <th>Room No</th>
                                <th>Column</th>
                                <th>Row (Bench)</th>
                                <th>Assigned Seat</th>
                            </tr>
                            <% studentSeating.forEach(s=> { %>
                                <tr>
                                    <td><strong><%= s.subject %></strong></td>
                                    <td><%= new Date(s.exam_date).toISOString().split('T')[0] %></td>
                                    <td><%= s.start_time %> - <%= s.end_time %></td>
                                    <td><%= s.room_no %></td>
                                    <td>Column <%= s.column_no %></td>
                                    <td>Bench <%= s.row_no %></td>
                                    <td><span class="badge"><%= s.seat_no %></span></td>
                                </tr>
                            <% }) %>
                        </table>
                    <% } %>
                </section>

                <!-- STUDENT VIEW: MY EXAMS & MARKS -->
                <section id="my_exams_marks" class="hidden">
                    <h2><i class="fa-solid fa-square-poll-vertical"></i> My Exams, Question Papers & Marks</h2>
                    <% if (!studentExamsWithMarks || studentExamsWithMarks.length === 0) { %>
                        <p class="no-data-msg">No exam or marks records available yet for your branch and semester.</p>
                    <% } else { %>
                        <table>
                            <tr>
                                <th>Subject</th>
                                <th>Date & Timing</th>
                                <th>Question Paper</th>
                                <th>My Marks & Breakdown</th>
                            </tr>
                            <% studentExamsWithMarks.forEach(e => { %>
                                <tr>
                                    <td><strong><%= e.subject %></strong></td>
                                    <td><%= e.exam_date %><br><small><%= e.start_time %> - <%= e.end_time %></small></td>
                                    <td>
                                        <% if (e.question_paper) { %>
                                            <a href="<%= e.question_paper %>" target="_blank" style="text-decoration: none;">
                                                <button type="button" class="btn-blue" style="padding: 5px 12px; font-size: 12px;">
                                                    <i class="fa-solid fa-download"></i> Download Paper
                                                </button>
                                            </a>
                                        <% } else { %>
                                            <span style="color: #94a3b8; font-style: italic;">Not Uploaded Yet</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (e.marks !== null && e.marks !== undefined) { %>
                                            <span class="badge bg-green" style="font-size: 13px; padding: 6px 12px;">
                                                Total: <%= e.marks %> / <%= e.total_marks %>
                                            </span>

                                            <% if (e.question_wise_marks && Object.keys(e.question_wise_marks).length > 0) { %>
                                                <div style="margin-top: 8px; display: flex; flex-wrap: wrap; gap: 5px;">
                                                    <% Object.entries(e.question_wise_marks).forEach(([q, val]) => { %>
                                                        <span style="background: #e2e8f0; color: #1e293b; padding: 2px 7px; border-radius: 4px; font-size: 11px; font-weight: bold; border: 1px solid #cbd5e1;">
                                                            <%= q %>: <%= val %>
                                                        </span>
                                                    <% }) %>
                                                </div>
                                            <% } %>
                                        <% } else { %>
                                            <span style="color: #94a3b8; font-style: italic;">Not Published</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </table>
                    <% } %>
                </section>

                <!-- STUDENT VIEW: PYQs & INTERACTIVE MCQ QUESTIONS -->
                <section id="student_pyqs" class="hidden">
                    <h2><i class="fa-solid fa-book-open"></i> PYQs & Practice Questions</h2>
                    
                    <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <span style="color: #1e3a8a; font-weight: bold;">Branch:</span> <span class="badge"><%= studentInfo ? studentInfo.branch : 'N/A' %></span>
                            &nbsp;&nbsp;
                            <span style="color: #1e3a8a; font-weight: bold;">Semester:</span> <span class="badge"><%= studentInfo ? studentInfo.semester + 'th' : 'N/A' %></span>
                        </div>

                        <div style="display: flex; align-items: center; gap: 10px;">
                            <label style="font-weight: bold; font-size: 13px; color: #1e3a8a;">Filter by Subject:</label>
                            <select id="studentSubjectFilter" onchange="filterStudentPyqs()" class="select-input" style="min-width: 180px;">
                                <option value="">-- All Subjects --</option>
                                <% studentSubjects.forEach(sub => { %>
                                    <option value="<%= sub %>"><%= sub %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <h3 style="color: #1e3a8a; margin-bottom: 10px;"><i class="fa-solid fa-file-pdf"></i> Uploaded PYQ Papers</h3>
                    <% if (studentPyqs.length === 0) { %>
                        <p class="no-data-msg">No PYQ papers have been uploaded for your branch and semester yet.</p>
                    <% } else { %>
                        <table>
                            <tr>
                                <th style="width: 70px; text-align: center;">Done?</th>
                                <th>Question / PYQ Title</th>
                                <th>Subject</th>
                                <th>Download / View</th>
                                <th>Status</th>
                            </tr>
                            <% studentPyqs.forEach(p => { %>
                                <tr class="student-pyq-row" data-subject="<%= (p.subject || '').toLowerCase() %>">
                                    <td style="text-align: center;">
                                        <input type="checkbox" id="chk_pyq_<%= p.id %>" <%= p.is_completed ? 'checked' : '' %> 
                                               onchange="togglePyqProgress('<%= p.id %>', this)" 
                                               style="width: 20px; height: 20px; cursor: pointer; accent-color: #16a34a;"
                                               title="Mark as done / Undo">
                                    </td>
                                    <td><strong><%= p.title %></strong></td>
                                    <td><span class="badge"><%= p.subject %></span></td>
                                    <td>
                                        <a href="<%= p.file_url %>" target="_blank" style="text-decoration: none;">
                                            <button type="button" class="btn-blue" style="padding: 5px 12px; font-size: 12px;">
                                                <i class="fa-solid fa-download"></i> View / Download
                                            </button>
                                        </a>
                                    </td>
                                    <td>
                                        <% if (p.is_completed) { %>
                                            <span id="status_pyq_<%= p.id %>" class="badge bg-green">Completed</span>
                                        <% } else { %>
                                            <span id="status_pyq_<%= p.id %>" class="badge" style="background: #94a3b8; color: white;">Pending</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </table>
                        <p id="noSubjectPyqMsg" class="no-data-msg hidden" style="text-align: center; margin-top: 15px;">Selected subject ke liye koi PYQ paper nahi mila.</p>
                    <% } %>

                    <br><hr><br>

                    <!-- STUDENT INTERACTIVE MCQ PRACTICE SECTION -->
                    <h3 style="color: #1e3a8a; margin-bottom: 12px;"><i class="fa-solid fa-list-check"></i> Practice MCQ Questions</h3>
                    <% if (!studentMcqs || studentMcqs.length === 0) { %>
                        <p class="no-data-msg">No MCQ questions have been posted for your branch and semester yet.</p>
                    <% } else { %>
                        <div id="studentMcqsContainer" style="display: flex; flex-direction: column; gap: 15px;">
                            <% studentMcqs.forEach((m, index) => { %>
                                <div class="poll-card student-mcq-card" id="mcq_card_<%= m.id %>" data-subject="<%= (m.subject || '').toLowerCase() %>" style="padding: 18px; border: 1px solid #cbd5e1;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 10px;">
                                        <div>
                                            <span class="badge" style="margin-bottom: 6px; display: inline-block;"><%= m.subject %></span>
                                            <h4 style="margin: 0; font-size: 16px; color: #0f172a;">Q<%= index + 1 %>. <%= m.question %></h4>
                                        </div>
                                        <span class="badge <%= m.is_multiple ? 'bg-purple' : 'bg-blue' %>" style="font-size: 11px; white-space: nowrap;">
                                            <%= m.is_multiple ? 'Multi-Option Choice' : 'Single-Option Choice' %>
                                        </span>
                                    </div>

                                    <div id="mcq_options_box_<%= m.id %>" style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px;">
                                        <% m.options.forEach(opt => { 
                                            const isSelected = m.has_submitted && m.selected_options.includes(opt.option_id);
                                            const isCorrectOpt = m.has_submitted && m.correct_options.includes(opt.option_id);
                                            let rowClass = m.has_submitted ? 'mcq-lbl-locked' : 'mcq-lbl-default';
                                            if (m.has_submitted) {
                                                if (isCorrectOpt) {
                                                    rowClass = 'mcq-lbl-correct';
                                                } else if (isSelected && !isCorrectOpt) {
                                                    rowClass = 'mcq-lbl-wrong';
                                                }
                                            }
                                        %>
                                            <label class="mcq-student-opt-label <%= rowClass %>" id="mcq_lbl_<%= m.id %>_<%= opt.option_id %>" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-radius: 6px;">
                                                <div style="display: flex; align-items: center; gap: 10px;">
                                                    <input type="<%= m.is_multiple ? 'checkbox' : 'radio' %>"
                                                           name="student_mcq_<%= m.id %>"
                                                           value="<%= opt.option_id %>"
                                                           <%= isSelected ? 'checked' : '' %>
                                                           <%= m.has_submitted ? 'disabled' : '' %>
                                                           class="<%= m.has_submitted ? 'cursor-default' : 'cursor-pointer' %>"
                                                           style="width: 18px; height: 18px; accent-color: #2563eb;">
                                                    <span style="font-size: 14px; font-weight: bold; color: #1e293b;"><%= opt.text %></span>
                                                </div>
                                                <div class="mcq-opt-badges" id="mcq_badge_<%= m.id %>_<%= opt.option_id %>">
                                                    <% if (m.has_submitted) { %>
                                                        <% if (isSelected) { %>
                                                            <span class="badge" style="background: #1e293b; color: white; font-size: 11px; margin-right: 5px;">Your Choice</span>
                                                        <% } %>
                                                        <% if (isCorrectOpt) { %>
                                                            <span class="badge bg-green" style="font-size: 11px;">✔ Correct Answer</span>
                                                        <% } else if (isSelected && !isCorrectOpt) { %>
                                                            <span class="badge bg-red" style="font-size: 11px;">✖ Wrong</span>
                                                        <% } %>
                                                    <% } %>
                                                </div>
                                            </label>
                                        <% }) %>
                                    </div>

                                    <div id="mcq_action_area_<%= m.id %>" style="margin-top: 14px;">
                                        <% if (!m.has_submitted) { %>
                                            <button type="button" id="mcq_submit_btn_<%= m.id %>" class="btn-green" style="padding: 8px 20px; font-weight: bold;" onclick="submitStudentMcqAnswer('<%= m.id %>')">
                                                <i class="fa-solid fa-check-double"></i> Submit Answer
                                            </button>
                                        <% } else { %>
                                            <% if (m.is_correct) { %>
                                                <div class="alert alert-success" style="margin: 0; font-weight: bold; font-size: 14px;">
                                                    🎉 Congratulations! Your answer is correct.
                                                </div>
                                            <% } else { %>
                                                <div class="alert alert-error" style="margin: 0; font-weight: bold; font-size: 14px;">
                                                    ❌ wrong answer, please study well and focus on this topic
                                                </div>
                                            <% } %>
                                            <div style="margin-top: 6px; font-size: 12px; color: #64748b; font-weight: bold;">
                                                <i class="fa-solid fa-lock"></i> Answer submitted & locked. You cannot change your answer.
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <!-- STUDENT VIEW: CHAT & LIVE POLLS -->
                <section id="student_chat" class="hidden">
                    <h2><i class="fa-solid fa-comments"></i> Class Chat & Live Polls</h2>
                    <% if (!studentInfo || !studentInfo.branch || !studentInfo.semester) { %>
                        <p class="no-data-msg">Your student profile is incomplete. A valid branch and semester are required to access the chat feature.</p>
                    <% } else { %>
                        <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 10px 15px; border-radius: 8px; margin-bottom: 15px;">
                            💬 <strong>Active Room:</strong> <%= studentInfo.branch %> (Semester <%= studentInfo.semester %>) — 
                            <small style="color: #64748b;">(Chat auto-deletes in 24h, Polls in 48h)</small>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div>
                                <h3 style="margin-top: 0; color: #1e3a8a;"><i class="fa-solid fa-square-poll-horizontal"></i> Active Polls</h3>
                                <div id="studentPollsList" style="max-height: 500px; overflow-y: auto;">
                                    <p style="color: #64748b; font-style: italic;">Loading polls...</p>
                                </div>
                            </div>

                            <div>
                                <h3 style="margin-top: 0; color: #1e3a8a;"><i class="fa-solid fa-message"></i> Class Conversation</h3>
                                <div class="chat-container">
                                    <div class="chat-messages" id="studentChatMessages"></div>
                                    <div class="chat-input-bar">
                                        <input id="studentMsgInput" placeholder="Type a message..." style="flex: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px;" onkeypress="handleStudentChatKey(event)">
                                        <button type="button" class="btn-blue" onclick="sendStudentMessage()"><i class="fa-solid fa-paper-plane"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </section>

            <% } %>

        </main>
    </div>

    <% if (user.role !== 'admin') { %>
        <!-- FLOATING AI CHATBOT BUTTON (BOTTOM-RIGHT) -->
        <button type="button" class="ai-fab-btn" onclick="toggleAiChatbotPopup()" title="Open AI Study Assistant">
            <i class="fa-solid fa-robot" id="aiFabIcon"></i>
        </button>

        <!-- FLOATING AI CHATBOT WINDOW (BOTTOM-RIGHT) -->
        <div id="aiFloatingPopup" class="ai-floating-panel hidden">
            <!-- Header -->
            <div class="ai-floating-header">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-robot" style="font-size: 18px;"></i>
                    <div>
                        <div style="font-weight: bold; font-size: 14px;">AI Study Assistant</div>
                        <div style="font-size: 10px; opacity: 0.85;">Select Portal Doc or Upload Photo</div>
                    </div>
                </div>
                <div style="display: flex; gap: 6px;">
                    <button type="button" class="btn-red" style="padding: 4px 8px; font-size: 11px;" onclick="clearAiChat()" title="Clear Chat">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                    <button type="button" style="background: rgba(255,255,255,0.2); padding: 4px 9px; font-size: 12px;" onclick="toggleAiChatbotPopup()" title="Minimize">
                        ✕
                    </button>
                </div>
            </div>

            <!-- Document / Photo Selector Bar -->
            <div style="background: #faf5ff; border-bottom: 1px solid #e9d5ff; padding: 8px 10px; display: flex; flex-direction: column; gap: 6px;">
                <div style="display: flex; gap: 6px; align-items: center;">
                    <!-- 1. Select Portal Documents shown to Student -->
                    <select id="aiPortalDocSelect" class="select-input" style="flex: 1; padding: 6px; font-size: 11px;" onchange="onPortalDocChange()">
                        <option value="">📚 Select Portal PYQ / Paper...</option>
                        <% if (studentPyqs && studentPyqs.length > 0) { %>
                            <optgroup label="My PYQs & Questions">
                                <% studentPyqs.forEach(p => { %>
                                    <option value="<%= p.file_url %>">PYQ: <%= p.title %> (<%= p.subject %>)</option>
                                <% }) %>
                            </optgroup>
                        <% } %>
                        <% if (studentExamsWithMarks && studentExamsWithMarks.length > 0) { %>
                            <optgroup label="My Exam Question Papers">
                                <% studentExamsWithMarks.forEach(e => { if (e.question_paper) { %>
                                    <option value="<%= e.question_paper %>">Exam: <%= e.subject %> (<%= e.exam_date %>)</option>
                                <% } }) %>
                            </optgroup>
                        <% } %>
                    </select>

                    <!-- 2. Upload Custom Photo / PDF Button -->
                    <label for="aiCustomFileInput" style="background: #7e22ce; color: white; padding: 6px 10px; border-radius: 5px; font-size: 11px; font-weight: bold; cursor: pointer; white-space: nowrap;" title="Upload Photo or PDF">
                        <i class="fa-solid fa-camera"></i> Upload
                    </label>
                    <input type="file" id="aiCustomFileInput" accept=".pdf,.png,.jpg,.jpeg,.webp" style="display: none;" onchange="onCustomFileChange()">
                </div>

                <!-- Attached File Indicator -->
                <div id="aiFileBadge" class="hidden" style="background: #f3e8ff; border: 1px solid #c084fc; padding: 4px 8px; border-radius: 5px; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 11px; font-weight: bold; color: #6b21a8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 280px;">
                        <i class="fa-solid fa-paperclip"></i> <span id="aiFileBadgeName"></span>
                    </span>
                    <button type="button" class="btn-red" style="padding: 1px 6px; font-size: 10px;" onclick="resetAiFiles()">✕</button>
                </div>
            </div>

            <!-- Chat Messages Area -->
