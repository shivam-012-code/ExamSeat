                                                <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: bold;">
                                                    <span class="<%= isCorr ? 'text-correct' : 'text-normal' %>">
                                                        <% if (isCorr) { %>✔ (Correct) <% } %><%= opt.text %>
                                                    </span>
                                                    <span style="color: #1e3a8a;"><%= opt.votes_count %> votes (<%= opt.percentage %>%)</span>
                                                </div>
                                                <div class="poll-progress-bg" style="margin: 4px 0 0 0; height: 6px;">
                                                    <div class="poll-progress-fill <%= isCorr ? 'bg-green' : 'bg-blue' %> js-set-width" data-width="<%= opt.percentage %>"></div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </td>
                                    <td>
                                        <button type="button" class="btn-blue" style="margin-bottom: 5px; font-size: 12px; padding: 6px 10px;" onclick="openInspectMcqModal('<%= m.id %>')">
                                            <i class="fa-solid fa-users-viewfinder"></i> Voters (<%= m.total_votes %>)
