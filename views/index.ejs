<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exam Seating Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <style>
    body { background-color: #f8f9fa; }
    .bench-container {
      display: inline-flex;
      gap: 6px;
      background: #e9ecef;
      padding: 6px;
      border-radius: 6px;
      border: 2px solid #ced4da;
      margin: 4px;
    }
    .seat-btn {
      width: 40px;
      height: 40px;
      border-radius: 4px;
      border: 1px solid #6c757d;
      background-color: #ffffff;
      cursor: pointer;
      font-size: 11px;
      font-weight: bold;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .seat-btn.selected-blue {
      background-color: #0d6efd !important;
      color: white !important;
      border-color: #0a58ca;
    }
    .seat-btn.selected-green {
      background-color: #198754 !important;
      color: white !important;
      border-color: #146c43;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Exam Seating System</a>
      <div class="d-flex align-items-center text-white">
        <span class="me-3"><i class="bi bi-person-circle me-1"></i> <%= user ? user.username : '' %> (<%= user ? user.role.toUpperCase() : '' %>)</span>
        <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
      </div>
    </div>
  </nav>

  <div class="container pb-5">
    <% if (user && user.role === 'admin') { %>
      <!-- ADMIN DASHBOARD TABS -->
      <ul class="nav nav-tabs mb-4" id="adminTabs">
        <li class="nav-item">
          <a class="nav-link <%= (activeTab === 'exams' || activeTab === '') ? 'active' : '' %>" href="/?active_tab=exams"><i class="bi bi-journal-text me-1"></i>Exams & Seating</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activeTab === 'rooms' ? 'active' : '' %>" href="/?active_tab=rooms"><i class="bi bi-door-open me-1"></i>Rooms Configuration</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activeTab === 'students' ? 'active' : '' %>" href="/?active_tab=students"><i class="bi bi-people me-1"></i>Students Directory</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activeTab === 'admin_users' ? 'active' : '' %>" href="/?active_tab=admin_users"><i class="bi bi-shield-lock me-1"></i>Admin Accounts</a>
        </li>
      </ul>

      <% if (activeTab === 'rooms') { %>
        <!-- ROOMS MANAGEMENT TAB -->
        <div class="row g-4">
          <div class="col-md-5">
            <div class="card shadow-sm">
              <div class="card-header bg-primary text-white fw-bold"><i class="bi bi-plus-circle me-1"></i> Add Room (Dynamic Columns)</div>
              <div class="card-body">
                <form action="/add_room" method="POST">
                  <div class="mb-3">
                    <label class="form-label fw-bold">Room Number / Hall Name:</label>
                    <input type="text" name="room_no" class="form-control" placeholder="e.g. LH-101" required>
                  </div>
                  <label class="form-label fw-bold">Columns & Rows (Benches):</label>
                  <div id="columns-container">
                    <div class="row g-2 align-items-center mb-2">
                      <div class="col-auto"><span class="fw-bold">Col 1:</span></div>
                      <div class="col">
                        <input type="number" name="column_rows[]" class="form-control" placeholder="Number of Benches (Rows)" min="1" required>
                      </div>
                    </div>
                  </div>
                  <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="addColumnInput()">
                    <i class="bi bi-plus-lg"></i> + Add More Column
                  </button>
                  <button type="submit" class="btn btn-success w-100 fw-bold">Create Room Layout</button>
                </form>
              </div>
            </div>
          </div>

          <div class="col-md-7">
            <div class="card shadow-sm">
              <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-building me-1"></i> Existing Room Layouts</div>
              <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>Room No</th>
                      <th>Column Details</th>
                      <th>Total Capacity</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (rooms && rooms.length > 0) { %>
                      <% rooms.forEach(r => { %>
                        <tr>
                          <td class="fw-bold"><%= r.room_no %></td>
                          <td>
                            <% if (r.columns_config && r.columns_config.length > 0) { %>
                              <% r.columns_config.forEach(c => { %>
                                <span class="badge bg-secondary mb-1">Col <%= c.column_no %>: <%= c.rows %> Benches</span>
                              <% }) %>
                            <% } else { %>
                              <span class="badge bg-warning text-dark">Legacy Layout</span>
                            <% } %>
                          </td>
                          <td><span class="badge bg-primary"><%= r.capacity || 0 %> Seats</span></td>
                          <td>
                            <form action="/delete_room/<%= r.id %>" method="POST" onsubmit="return confirm('Delete room?')">
                              <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr><td colspan="4" class="text-center py-3 text-muted">No rooms added yet.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

      <% } else if (activeTab === 'students') { %>
        <!-- STUDENTS TAB -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-primary text-white fw-bold"><i class="bi bi-person-plus me-1"></i> Add Student</div>
          <div class="card-body">
            <form action="/add_student" method="POST" class="row g-3">
              <div class="col-md-3"><input type="text" name="reg_no" class="form-control" placeholder="Reg / Roll No" required></div>
              <div class="col-md-3"><input type="text" name="name" class="form-control" placeholder="Student Name" required></div>
              <div class="col-md-2"><input type="text" name="branch" class="form-control" placeholder="Branch"></div>
              <div class="col-md-2"><input type="number" name="semester" class="form-control" placeholder="Semester"></div>
              <div class="col-md-2"><button type="submit" class="btn btn-success w-100 fw-bold">Save Student</button></div>
            </form>
          </div>
        </div>

        <div class="card shadow-sm mb-4">
          <div class="card-header bg-success text-white fw-bold"><i class="bi bi-file-earmark-excel me-1"></i> Upload Students Excel</div>
          <div class="card-body">
            <form action="/upload_students" method="POST" enctype="multipart/form-data" class="row g-3">
              <div class="col-md-4"><input type="file" name="excel_file" class="form-control" accept=".xlsx, .xls" required></div>
              <div class="col-md-3"><input type="text" name="branch" class="form-control" placeholder="Branch (Optional)"></div>
              <div class="col-md-3"><input type="number" name="semester" class="form-control" placeholder="Semester (Optional)"></div>
              <div class="col-md-2"><button type="submit" class="btn btn-primary w-100 fw-bold">Upload Excel</button></div>
            </form>
          </div>
        </div>

      <% } else if (activeTab === 'admin_users') { %>
        <!-- ADMIN USERS TAB -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-shield-lock me-1"></i> Registered Admin Accounts</div>
          <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
              <thead class="table-light">
                <tr>
                  <th>Username</th>
                  <th>Role</th>
                  <th>Created At</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (adminUsers && adminUsers.length > 0) { %>
                  <% adminUsers.forEach(u => { %>
                    <tr>
                      <td class="fw-bold"><%= u.username %></td>
                      <td><span class="badge bg-success"><%= u.role %></span></td>
                      <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                      <td>
                        <% if (u.id !== user.id) { %>
                          <form action="/delete_admin/<%= u.id %>" method="POST" onsubmit="return confirm('Delete this admin?')">
                            <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Remove Admin</button>
                          </form>
                        <% } else { %>
                          <span class="text-muted small">Current User</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      <% } else { %>
        <!-- EXAMS & GRAPHICAL SEATING TAB (DEFAULT) -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-primary text-white fw-bold"><i class="bi bi-pencil-square me-1"></i> Add New Exam Schedule</div>
          <div class="card-body">
            <form action="/add_exam" method="POST" class="row g-3">
              <div class="col-md-3">
                <input type="text" name="subject" class="form-control" placeholder="Subject Name" required>
              </div>
              <div class="col-md-2">
                <input type="text" name="branch" class="form-control" placeholder="Branch (e.g. CSE)">
              </div>
              <div class="col-md-2">
                <input type="number" name="semester" class="form-control" placeholder="Semester (e.g. 4)">
              </div>
              <div class="col-md-2">
                <select name="room_id" class="form-select">
                  <option value="">Select Room</option>
                  <% if (rooms) { %>
                    <% rooms.forEach(r => { %>
                      <option value="<%= r.id %>"><%= r.room_no %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>
              <div class="col-md-3">
                <input type="date" name="exam_date" class="form-control" required>
              </div>
              <div class="col-md-3">
                <input type="text" name="start_time" class="form-control" placeholder="Start Time (09:00 AM)" required>
              </div>
              <div class="col-md-3">
                <input type="text" name="end_time" class="form-control" placeholder="End Time (12:00 PM)" required>
              </div>
              <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100 fw-bold">+ Add Exam</button>
              </div>
            </form>
          </div>
        </div>

        <!-- EXAMS LIST -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-list-check me-1"></i> Scheduled Exams</div>
          <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
              <thead class="table-light">
                <tr>
                  <th>Subject</th>
                  <th>Target</th>
                  <th>Assigned Room</th>
                  <th>Date & Time</th>
                  <th>Actions & Interactive Grid</th>
                </tr>
              </thead>
              <tbody>
                <% if (exams && exams.length > 0) { %>
                  <% exams.forEach(e => { %>
                    <tr>
                      <td class="fw-bold"><%= e.subject %></td>
                      <td><%= e.branch || 'All' %> - Sem <%= e.semester || 'All' %></td>
                      <td><%= e.room_no ? e.room_no : 'Not Set' %></td>
                      <td><%= e.exam_date ? new Date(e.exam_date).toLocaleDateString() : 'N/A' %> (<%= e.start_time %>)</td>
                      <td>
                        <div class="btn-group">
                          <button type="button" class="btn btn-primary btn-sm" onclick="openGraphicalGrid('<%= e.id %>')">
                            <i class="bi bi-grid-fill me-1"></i> Interactive Seating Matrix
                          </button>
                          <a href="/export_seating_excel/<%= e.id %>" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Excel</a>
                          <a href="/export_seating_pdf/<%= e.id %>" class="btn btn-outline-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center py-3 text-muted">No exams scheduled yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- GRAPHICAL INTERACTIVE MATRIX SECTION -->
        <div id="interactive-matrix-section" class="card shadow-sm d-none mb-4">
          <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-palette me-1"></i> Interactive Dual-Color Bench Selector</span>
            <button class="btn btn-sm btn-light" onclick="document.getElementById('interactive-matrix-section').classList.add('d-none')">X Close</button>
          </div>
          <div class="card-body">
            <h5 id="selected-exam-title" class="fw-bold text-primary"></h5>
            <p class="text-muted">Click bench seats (`A` = Left, `B` = Right) to toggle selection. Use color brush to assign different test groups.</p>
            
            <div class="d-flex gap-3 mb-3 align-items-center">
              <span class="fw-bold">Active Brush Color:</span>
              <button type="button" id="btn-blue-mode" class="btn btn-primary btn-sm" onclick="setActiveColor('blue')">🔵 Group 1 (Blue)</button>
              <button type="button" id="btn-green-mode" class="btn btn-outline-success btn-sm" onclick="setActiveColor('green')">🟢 Group 2 (Green)</button>
            </div>

            <div id="graphical-room-grid" class="d-flex overflow-auto gap-4 p-4 border rounded bg-light mb-3"></div>

            <!-- ORIGINAL ACTION URL RESTORED: /generate_seating/:exam_id -->
            <form action="" method="POST" id="custom-seating-form">
              <input type="hidden" name="selected_seats" id="selected-seats-input">
              <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-cpu me-1"></i> Generate Seating Allocation On Selected Benches</button>
            </form>
          </div>
        </div>
      <% } %>

    <% } else { %>
      <!-- STUDENT DASHBOARD VIEW -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-bold"><i class="bi bi-person-badge me-1"></i> Student Profile</div>
        <div class="card-body">
          <% if (studentInfo) { %>
            <div class="row text-center">
              <div class="col-md-3"><strong>Name:</strong> <%= studentInfo.name %></div>
              <div class="col-md-3"><strong>Reg No:</strong> <%= studentInfo.reg_no %></div>
              <div class="col-md-3"><strong>Branch:</strong> <%= studentInfo.branch || 'N/A' %></div>
              <div class="col-md-3"><strong>Semester:</strong> <%= studentInfo.semester || 'N/A' %></div>
            </div>
          <% } else { %>
            <p class="text-danger mb-0">Student details not found in database. Please contact Admin.</p>
          <% } %>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-calendar-check me-1"></i> Allocated Exam Seating Schedule</div>
        <div class="card-body p-0">
          <table class="table table-striped mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th>Subject</th>
                <th>Exam Date</th>
                <th>Timing</th>
                <th>Room No</th>
                <th>Column</th>
                <th>Bench (Row)</th>
                <th>Position</th>
                <th>Group Color</th>
              </tr>
            </thead>
            <tbody>
              <% if (studentSeating && studentSeating.length > 0) { %>
                <% studentSeating.forEach(s => { %>
                  <tr>
                    <td class="fw-bold"><%= s.subject %></td>
                    <td><%= s.exam_date ? new Date(s.exam_date).toLocaleDateString() : 'N/A' %></td>
                    <td><%= s.start_time %> - <%= s.end_time %></td>
                    <td><span class="badge bg-primary"><%= s.room_no %></span></td>
                    <td>Col <%= s.column_no %></td>
                    <td>Bench <%= s.row_no %></td>
                    <td><span class="badge bg-secondary"><%= s.seat_position === 'A' ? 'Left Seat (A)' : 'Right Seat (B)' %></span></td>
                    <td>
                      <span class="badge <%= s.color_tag === 'green' ? 'bg-success' : 'bg-primary' %>">
                        <%= s.color_tag ? s.color_tag.toUpperCase() : 'BLUE' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="8" class="text-center py-4 text-muted">No seating plan assigned yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <script>
    const globalExams = <%- JSON.stringify(typeof exams !== 'undefined' ? exams : []) %>;

    let colCount = 1;
    function addColumnInput() {
      colCount++;
      const container = document.getElementById('columns-container');
      const div = document.createElement('div');
      div.className = 'row g-2 align-items-center mb-2';
      div.innerHTML = `
        <div class="col-auto"><span class="fw-bold">Col ${colCount}:</span></div>
        <div class="col">
          <input type="number" name="column_rows[]" class="form-control" placeholder="Number of Benches (Rows)" min="1" required>
        </div>
        <div class="col-auto">
          <button type="button" class="btn btn-danger btn-sm" onclick="this.parentElement.parentElement.remove()">X</button>
        </div>
      `;
      container.appendChild(div);
    }

    let activeColor = 'blue';
    let selectedSeats = [];

    function setActiveColor(color) {
      activeColor = color;
      if (color === 'blue') {
        document.getElementById('btn-blue-mode').className = 'btn btn-primary btn-sm';
        document.getElementById('btn-green-mode').className = 'btn btn-outline-success btn-sm';
      } else {
        document.getElementById('btn-blue-mode').className = 'btn btn-outline-primary btn-sm';
        document.getElementById('btn-green-mode').className = 'btn btn-success btn-sm';
      }
    }

    function openGraphicalGrid(examId) {
      const exam = globalExams.find(e => e.id === examId);
      if (!exam) return;

      document.getElementById('interactive-matrix-section').classList.remove('d-none');
      document.getElementById('selected-exam-title').innerText = `Seating Matrix for ${exam.subject} (${exam.room_no || 'Room'})`;
      
      // RESTORED ORIGINAL ROUTE URL
      document.getElementById('custom-seating-form').action = `/generate_seating/${exam.id}`;
      
      selectedSeats = [];
      document.getElementById('selected-seats-input').value = '[]';

      const grid = document.getElementById('graphical-room-grid');
      grid.innerHTML = '';

      if (!exam.columns_config || exam.columns_config.length === 0) {
        grid.innerHTML = '<p class="text-danger fw-bold">Please assign a room with valid columns layout to this exam first.</p>';
        return;
      }

      exam.columns_config.forEach(col => {
        const colDiv = document.createElement('div');
        colDiv.className = 'd-flex flex-column align-items-center';
        colDiv.innerHTML = `<h6 class="text-secondary fw-bold mb-2">Column ${col.column_no}</h6>`;

        for (let r = 1; r <= col.rows; r++) {
          const bench = document.createElement('div');
          bench.className = 'bench-container';

          const seatA = document.createElement('button');
          seatA.type = 'button';
          seatA.className = 'seat-btn';
          seatA.innerText = 'A';
          seatA.onclick = () => toggleSeat(seatA, exam.room_no, col.column_no, r, 'A');

          const seatB = document.createElement('button');
          seatB.type = 'button';
          seatB.className = 'seat-btn';
          seatB.innerText = 'B';
          seatB.onclick = () => toggleSeat(seatB, exam.room_no, col.column_no, r, 'B');

          bench.appendChild(seatA);
          bench.appendChild(seatB);
          colDiv.appendChild(bench);
        }
        grid.appendChild(colDiv);
      });

      document.getElementById('interactive-matrix-section').scrollIntoView({ behavior: 'smooth' });
    }

    function toggleSeat(btn, roomNo, col, row, pos) {
      const existingIndex = selectedSeats.findIndex(s => s.col === col && s.row === row && s.pos === pos);

      if (existingIndex > -1) {
        if (selectedSeats[existingIndex].color === activeColor) {
          selectedSeats.splice(existingIndex, 1);
          btn.className = 'seat-btn';
        } else {
          selectedSeats[existingIndex].color = activeColor;
          btn.className = `seat-btn selected-${activeColor}`;
        }
      } else {
        selectedSeats.push({ room_no: roomNo, col, row, pos, color: activeColor });
        btn.className = `seat-btn selected-${activeColor}`;
      }

      document.getElementById('selected-seats-input').value = JSON.stringify(selectedSeats);
    }
  </script>
</body>
</html>